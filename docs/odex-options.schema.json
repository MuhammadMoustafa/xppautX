{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xppautX .odex options",
  "description": "The options block of a .odex model: options { group: { key: value, ... }, ... }. Generated from core/model_options.cpp by xppautX --options-schema; the JSON form of the block's dictionary. A key marked x-repeatable may be written more than once; a path or a text is a double-quoted string, sliders a list of presets, every other value one bare word.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "animation": {"type": "string", "x-kind": "path"},
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_time": {"type": "number", "minimum": 0, "description": "Total time"},
        "start_time": {"type": "number", "description": "Start time"},
        "dt": {"type": "number", "description": "Dt"},
        "store_every": {"type": "integer", "minimum": 1, "description": "Store every N steps"},
        "store_from": {"type": "number", "description": "Store from"},
        "state_limit": {"type": "number", "exclusiveMinimum": 0, "description": "State limit"},
        "stop_at_limit": {"type": "boolean", "description": "Stop at the limit"},
        "method": {"type": "string", "enum": ["discrete", "euler", "modified_euler", "runge_kutta", "adams", "gear", "volterra", "backward_euler", "qualrk", "stiff", "cvode", "dopri5", "dopri8", "rosenbrock", "symplectic"], "description": "Method"},
        "subsystem_split": {"type": "string", "enum": ["equations", "run"], "description": "Subsystem split"},
        "seed": {"type": "integer"},
        "storage_rows": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "stochastic": {"type": "integer"},
        "step.relative_tolerance": {"type": "number", "exclusiveMinimum": 0, "description": "Relative tolerance"},
        "step.absolute_tolerance": {"type": "number", "exclusiveMinimum": 0, "description": "Absolute tolerance"},
        "step.min": {"type": "number", "exclusiveMinimum": 0, "description": "Minimum step"},
        "step.max": {"type": "number", "exclusiveMinimum": 0, "description": "Maximum step"},
        "jacobian.kind": {"type": "string", "enum": ["difference", "exact"], "description": "Jacobian"},
        "jacobian.band_upper": {"type": "integer", "minimum": 0, "maximum": 100000},
        "jacobian.band_lower": {"type": "integer", "minimum": 0, "maximum": 100000},
        "delay.max_delay": {"type": "number", "minimum": 0, "description": "Maximal delay"},
        "delay.history_points": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "euler.tolerance": {"type": "number", "exclusiveMinimum": 0, "description": "Newton tolerance"},
        "euler.iterations": {"type": "integer", "minimum": 1, "description": "Newton iterations"},
        "bvp.max_iterates": {"type": "integer", "minimum": 1, "description": "BVP maximum iterates"},
        "bvp.tolerance": {"type": "number", "exclusiveMinimum": 0, "description": "BVP tolerance"},
        "bvp.epsilon": {"type": "number", "exclusiveMinimum": 0, "description": "BVP epsilon"},
        "torus.period": {"type": "number", "exclusiveMinimum": 0},
        "torus.fold": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$", "x-repeatable": true},
        "tables.auto_evaluate": {"type": "integer"}
      }
    },
    "poincare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "map": {"type": "string", "enum": ["none", "section", "max", "period"]},
        "variable": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "sign": {"type": "string", "enum": ["negative", "both", "positive"]},
        "plane": {"type": "number"},
        "stop": {"type": "boolean"}
      }
    },
    "equilibria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": {"type": "integer", "minimum": 1, "description": "Equilibria: maximum iterations"},
        "newton_tolerance": {"type": "number", "exclusiveMinimum": 0, "description": "Equilibria: Newton tolerance"},
        "jacobian_step": {"type": "number", "exclusiveMinimum": 0, "description": "Equilibria: Jacobian step"},
        "search_limit": {"type": "number", "exclusiveMinimum": 0, "description": "Equilibria: search limit"},
        "print_eigenvalues": {"type": "boolean", "description": "Equilibria: print eigenvalues"},
        "draw_invariant_sets": {"type": "boolean", "description": "Equilibria: draw invariant sets"},
        "draw_strong_sets": {"type": "boolean", "description": "Equilibria: draw strong sets"},
        "near_tolerance": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "sweep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variable": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "steps": {"type": "integer", "minimum": 1},
        "low": {"type": "number"},
        "high": {"type": "number"},
        "reset": {"type": "boolean"},
        "old_ic": {"type": "boolean"},
        "write_files": {"type": "boolean"}
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mesh_intervals": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_steps": {"type": "integer", "minimum": 1},
        "output_every": {"type": "integer", "minimum": 1},
        "collocation_points": {"type": "integer", "minimum": 2, "maximum": 7},
        "min_step_size": {"type": "number", "exclusiveMinimum": 0},
        "max_step_size": {"type": "number", "exclusiveMinimum": 0},
        "step_size": {"type": "number"},
        "parameter_min": {"type": "number"},
        "parameter_max": {"type": "number"},
        "norm_min": {"type": "number"},
        "norm_max": {"type": "number"},
        "parameter_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "state_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "special_point_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "mesh_adapt_every": {"type": "integer", "minimum": 0},
        "max_branch_switches": {"type": "integer", "minimum": 0},
        "switch_one_direction": {"type": "boolean", "minimum": 0, "maximum": 1},
        "output_detail": {"type": "string", "enum": ["none", "little", "normal", "start_jacobian", "extensive", "debugging"], "minimum": 0, "maximum": 5},
        "max_location_iterations": {"type": "integer", "minimum": 1},
        "max_newton_iterations": {"type": "integer", "minimum": 1},
        "full_newton_after": {"type": "integer", "minimum": 1},
        "step_adapt_every": {"type": "integer", "minimum": 0},
        "suppress_branch_points": {"type": "boolean", "minimum": 0, "maximum": 1},
        "follow_all_branches": {"type": "boolean", "minimum": 0, "maximum": 1}
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variable": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "x_min": {"type": "number"},
        "x_max": {"type": "number"},
        "y_min": {"type": "number"},
        "y_max": {"type": "number"},
        "colors.stable_equilibrium": {"type": "string", "x-kind": "color"},
        "colors.unstable_equilibrium": {"type": "string", "x-kind": "color"},
        "colors.stable_periodic": {"type": "string", "x-kind": "color"},
        "colors.unstable_periodic": {"type": "string", "x-kind": "color"}
      }
    },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colormap": {"type": "string", "enum": ["jet", "periodic", "hot", "cool", "blue_red", "gray", "cubehelix", "viridis", "plasma", "inferno", "magma", "cividis", "coolwarm", "rdbu", "seismic", "twilight", "hsv", "turbo", "greys", "blues", "reds", "greens", "oranges", "purples"]},
        "axes.kind": {"type": "integer", "enum": [2, 3]},
        "axes.x_low": {"type": "number"},
        "axes.x_high": {"type": "number"},
        "axes.y_low": {"type": "number"},
        "axes.y_high": {"type": "number"},
        "axes.x_min": {"type": "number"},
        "axes.x_max": {"type": "number"},
        "axes.y_min": {"type": "number"},
        "axes.y_max": {"type": "number"},
        "axes.z_min": {"type": "number"},
        "axes.z_max": {"type": "number"},
        "axes.phi": {"type": "number"},
        "axes.theta": {"type": "number"},
        "curves.x": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.y": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.z": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.count": {"type": "integer", "minimum": 1, "maximum": 8},
        "curves.x2": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.x3": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.x4": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.x5": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.x6": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.x7": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.x8": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.y2": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.y3": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.y4": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.y5": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.y6": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.y7": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.y8": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.z2": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.z3": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.z4": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.z5": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.z6": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.z7": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.z8": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "curves.x_low2": {"type": "number"},
        "curves.x_low3": {"type": "number"},
        "curves.x_low4": {"type": "number"},
        "curves.x_low5": {"type": "number"},
        "curves.x_low6": {"type": "number"},
        "curves.x_low7": {"type": "number"},
        "curves.x_low8": {"type": "number"},
        "curves.x_high2": {"type": "number"},
        "curves.x_high3": {"type": "number"},
        "curves.x_high4": {"type": "number"},
        "curves.x_high5": {"type": "number"},
        "curves.x_high6": {"type": "number"},
        "curves.x_high7": {"type": "number"},
        "curves.x_high8": {"type": "number"},
        "curves.y_low2": {"type": "number"},
        "curves.y_low3": {"type": "number"},
        "curves.y_low4": {"type": "number"},
        "curves.y_low5": {"type": "number"},
        "curves.y_low6": {"type": "number"},
        "curves.y_low7": {"type": "number"},
        "curves.y_low8": {"type": "number"},
        "curves.y_high2": {"type": "number"},
        "curves.y_high3": {"type": "number"},
        "curves.y_high4": {"type": "number"},
        "curves.y_high5": {"type": "number"},
        "curves.y_high6": {"type": "number"},
        "curves.y_high7": {"type": "number"},
        "curves.y_high8": {"type": "number"},
        "line.draw": {"type": "string", "enum": ["line", "points", "both"]},
        "line.dash": {"type": "string", "enum": ["solid", "dashed", "dotted", "dash_dot"]},
        "line.width": {"type": "number"},
        "line.marker": {"type": "string", "enum": ["circle", "square", "triangle", "diamond", "cross", "plus", "star"]},
        "line.marker_size": {"type": "number"},
        "nullclines.mesh": {"type": "integer", "minimum": 1, "maximum": 4096, "description": "Nullcline mesh"},
        "nullclines.draw": {"type": "boolean"},
        "nullclines.x_color": {"type": "string", "x-kind": "color"},
        "nullclines.y_color": {"type": "string", "x-kind": "color"},
        "direction_field.grid": {"type": "integer", "minimum": 2, "maximum": 4096},
        "direction_field.draw": {"type": "string", "enum": ["none", "arrows", "scaled_arrows", "flow", "arrows_and_save", "scaled_arrows_and_save"]},
        "manifolds.stable_color": {"type": "string", "x-kind": "color"},
        "manifolds.unstable_color": {"type": "string", "x-kind": "color"},
        "color_by.enabled": {"type": "boolean"},
        "color_by.via": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "color_by.low": {"type": "number"},
        "color_by.high": {"type": "number"},
        "windows.simultaneous": {"type": "integer"},
        "windows.multiple": {"type": "integer"}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "histogram.low": {"type": "number"},
        "histogram.high": {"type": "number"},
        "histogram.bins": {"type": "integer", "minimum": 2, "maximum": 4096},
        "histogram.column": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "histogram2.low": {"type": "number"},
        "histogram2.high": {"type": "number"},
        "histogram2.bins": {"type": "integer", "minimum": 2, "maximum": 4096},
        "histogram2.column": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "spectrum.column": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "spectrum.column2": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "spectrum.width": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "spectrum.window": {"type": "integer"}
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {"type": "string", "enum": ["pdf", "svg"]},
        "color": {"type": "boolean"},
        "font_size": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sliders": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "low", "high"], "properties": {"name": {"type": "string"}, "low": {"type": "number"}, "high": {"type": "number"}, "step": {"type": "number", "minimum": 0}}}},
        "buttons": {"type": "string", "x-repeatable": true}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data_file": {"type": "string", "x-kind": "path"},
        "nullclines_file": {"type": "string", "x-kind": "path"},
        "after_run": {"type": "string", "enum": ["none", "histogram", "fourier_series", "power_spectrum", "psd_x", "psd_xy", "coherence_xy", "histogram_2d"]},
        "after_run_file": {"type": "string", "x-kind": "path"},
        "quiet": {"type": "integer", "enum": [0, 1]},
        "log_file": {"type": "string", "x-kind": "path"}
      }
    }
  }
}
