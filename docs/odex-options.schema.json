{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xppautX .odex options",
  "description": "The options block of a .odex model: options { group: { key: value, ... }, ... }. Generated from core/model_options.cpp by xppautX --options-schema; the JSON form of the block's dictionary. A key marked x-repeatable may be written more than once; a path or a text is a double-quoted string, sliders a list of presets, every other value one bare word.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_time": {"type": "number", "minimum": 0, "description": "Total time"},
        "start_time": {"type": "number", "description": "Start time"},
        "transient_time": {"type": "number", "description": "Transient time"},
        "dt": {"type": "number", "description": "Dt"},
        "store_every": {"type": "integer", "minimum": 1, "description": "Store every N steps"},
        "bound": {"type": "number", "exclusiveMinimum": 0, "description": "Bounds"},
        "method": {"type": "string", "enum": ["discrete", "euler", "modified_euler", "runge_kutta", "adams", "gear", "volterra", "backward_euler", "qualrk", "stiff", "cvode", "dopri5", "dopri8", "rosenbrock", "symplectic"], "description": "Method"},
        "jacobian": {"type": "string", "enum": ["difference", "exact"], "description": "Jacobian"},
        "tolerance": {"type": "number", "exclusiveMinimum": 0, "description": "Tolerance"},
        "min_step": {"type": "number", "exclusiveMinimum": 0, "description": "Minimum step"},
        "max_step": {"type": "number", "exclusiveMinimum": 0, "description": "Maximum step"},
        "abs_tolerance": {"type": "number", "exclusiveMinimum": 0, "description": "Absolute tolerance"},
        "delay": {"type": "number", "minimum": 0, "description": "Maximal delay"},
        "vmaxpts": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "storage_rows": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "torus_period": {"type": "number"},
        "fold": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$", "x-repeatable": true},
        "bandup": {"type": "integer", "minimum": 0, "maximum": 100000},
        "bandlo": {"type": "integer", "minimum": 0, "maximum": 100000},
        "seed": {"type": "integer"},
        "stoch": {"type": "integer"}
      }
    },
    "poincare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "poincare_map": {"type": "string", "enum": ["none", "section", "max", "period"]},
        "poincare_variable": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "poincare_sign": {"type": "integer"},
        "poincare_stop": {"type": "integer"},
        "poincare_plane": {"type": "number"}
      }
    },
    "equilibria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "singpt_max_iterates": {"type": "integer", "minimum": 1, "description": "Sing pt: maximum iterates"},
        "singpt_newton_tolerance": {"type": "number", "exclusiveMinimum": 0, "description": "Sing pt: Newton tolerance"},
        "singpt_jacobian_epsilon": {"type": "number", "exclusiveMinimum": 0, "description": "Sing pt: Jacobian epsilon"},
        "neartol": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ntst": {"type": "integer", "minimum": 1, "maximum": 10000},
        "nmax": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "npr": {"type": "integer"},
        "ncol": {"type": "integer", "minimum": 1, "maximum": 7},
        "dsmin": {"type": "number"},
        "dsmax": {"type": "number"},
        "ds": {"type": "number"},
        "parmin": {"type": "number"},
        "parmax": {"type": "number"},
        "normmin": {"type": "number"},
        "normmax": {"type": "number"},
        "epsl": {"type": "number"},
        "epsu": {"type": "number"},
        "epss": {"type": "number"}
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoeval": {"type": "integer"},
        "autoxmax": {"type": "number"},
        "autoymax": {"type": "number"},
        "autoxmin": {"type": "number"},
        "autoymin": {"type": "number"},
        "autovar": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "sec": {"type": "integer"},
        "uec": {"type": "integer"},
        "spc": {"type": "integer"},
        "upc": {"type": "integer"}
      }
    },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nullcline_mesh": {"type": "integer", "minimum": 1, "maximum": 4096, "description": "Nullcline mesh"},
        "xp": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "yp": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "zp": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "nplot": {"type": "integer"},
        "xp2": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "xp3": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "xp4": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "xp5": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "xp6": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "xp7": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "xp8": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "yp2": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "yp3": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "yp4": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "yp5": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "yp6": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "yp7": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "yp8": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "zp2": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "zp3": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "zp4": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "zp5": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "zp6": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "zp7": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "zp8": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "xlo2": {"type": "number"},
        "xlo3": {"type": "number"},
        "xlo4": {"type": "number"},
        "xlo5": {"type": "number"},
        "xlo6": {"type": "number"},
        "xlo7": {"type": "number"},
        "xlo8": {"type": "number"},
        "xhi2": {"type": "number"},
        "xhi3": {"type": "number"},
        "xhi4": {"type": "number"},
        "xhi5": {"type": "number"},
        "xhi6": {"type": "number"},
        "xhi7": {"type": "number"},
        "xhi8": {"type": "number"},
        "ylo2": {"type": "number"},
        "ylo3": {"type": "number"},
        "ylo4": {"type": "number"},
        "ylo5": {"type": "number"},
        "ylo6": {"type": "number"},
        "ylo7": {"type": "number"},
        "ylo8": {"type": "number"},
        "yhi2": {"type": "number"},
        "yhi3": {"type": "number"},
        "yhi4": {"type": "number"},
        "yhi5": {"type": "number"},
        "yhi6": {"type": "number"},
        "yhi7": {"type": "number"},
        "yhi8": {"type": "number"},
        "simplot": {"type": "integer"},
        "multiwin": {"type": "integer"},
        "axes": {"type": "integer", "enum": [2, 3]},
        "xlo": {"type": "number"},
        "xhi": {"type": "number"},
        "ylo": {"type": "number"},
        "yhi": {"type": "number"},
        "xmin": {"type": "number"},
        "xmax": {"type": "number"},
        "ymin": {"type": "number"},
        "ymax": {"type": "number"},
        "zmin": {"type": "number"},
        "zmax": {"type": "number"},
        "phi": {"type": "number"},
        "theta": {"type": "number"},
        "lt": {"type": "integer"},
        "ync": {"type": "integer"},
        "xnc": {"type": "integer"},
        "smc": {"type": "integer"},
        "umc": {"type": "integer"},
        "colormap": {"type": "integer"},
        "dfgrid": {"type": "integer"},
        "dfdraw": {"type": "integer"},
        "ncdraw": {"type": "integer"},
        "colorvia": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "colorize": {"type": "integer"},
        "colorlo": {"type": "number"},
        "colorhi": {"type": "number"}
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plotfmt": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "ps_font": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "ps_lw": {"type": "number"},
        "ps_fsize": {"type": "integer"},
        "ps_color": {"type": "integer"}
      }
    },
    "sweep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rangeover": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "rangestep": {"type": "integer"},
        "rangelow": {"type": "number"},
        "rangehigh": {"type": "number"},
        "rangereset": {"type": "string", "enum": ["no", "yes"]},
        "rangeoldic": {"type": "string", "enum": ["no", "yes"]},
        "rangefiles": {"type": "string", "enum": ["no", "yes"]}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postprocess": {"type": "integer"},
        "histlo": {"type": "number"},
        "histhi": {"type": "number"},
        "histbins": {"type": "integer", "minimum": 1, "maximum": 4096},
        "histcol": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "histlo2": {"type": "number"},
        "histhi2": {"type": "number"},
        "histbins2": {"type": "integer", "minimum": 1, "maximum": 4096},
        "histcol2": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "speccol": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "speccol2": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "specwidth": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "specwin": {"type": "integer"}
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sliders": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "low", "high"], "properties": {"name": {"type": "string"}, "low": {"type": "number"}, "high": {"type": "number"}, "step": {"type": "number", "minimum": 0}}}},
        "but": {"type": "string", "x-repeatable": true}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output": {"type": "string", "x-kind": "path"},
        "quiet": {"type": "integer", "enum": [0, 1]},
        "logfile": {"type": "string", "x-kind": "path"}
      }
    }
  }
}
