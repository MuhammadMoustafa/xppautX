{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xppautX .setx settings",
  "description": "A settings file of a model: the numerics (the option table's keys), the values, the delays, the boundary conditions and the active window's graphics, in the options syntax. Generated from core/setx_file.cpp and core/model_options.cpp by xppautX --setx-schema. The groups named by the model's variables or parameters hold one entry for each name.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "numerics": {"type": "object", "additionalProperties": false, "properties": {
      "total_time": {"type": "number", "description": "Total time"},
      "start_time": {"type": "number", "description": "Start time"},
      "transient_time": {"type": "number", "description": "Transient time"},
      "dt": {"type": "number", "description": "Dt"},
      "nullcline_mesh": {"type": "integer", "minimum": 1, "maximum": 4096, "description": "Nullcline mesh"},
      "singpt_max_iterates": {"type": "integer", "minimum": 1, "description": "Sing pt: maximum iterates"},
      "singpt_newton_tolerance": {"type": "number", "exclusiveMinimum": 0, "description": "Sing pt: Newton tolerance"},
      "singpt_jacobian_epsilon": {"type": "number", "exclusiveMinimum": 0, "description": "Sing pt: Jacobian epsilon"},
      "store_every": {"type": "integer", "minimum": 1, "description": "Store every N steps"},
      "bound": {"type": "number", "exclusiveMinimum": 0, "description": "Bounds"},
      "method": {"type": "string", "enum": ["discrete", "euler", "modified_euler", "runge_kutta", "adams", "gear", "volterra", "backward_euler", "qualrk", "stiff", "cvode", "dopri5", "dopri8", "rosenbrock", "symplectic"], "description": "Method"},
      "jacobian": {"type": "string", "enum": ["difference", "exact"], "description": "Jacobian"},
      "tolerance": {"type": "number", "exclusiveMinimum": 0, "description": "Tolerance"},
      "min_step": {"type": "number", "exclusiveMinimum": 0, "description": "Minimum step"},
      "max_step": {"type": "number", "exclusiveMinimum": 0, "description": "Maximum step"},
      "abs_tolerance": {"type": "number", "exclusiveMinimum": 0, "description": "Absolute tolerance"},
      "eul_tol": {"type": "number", "exclusiveMinimum": 0, "description": "Newton tolerance"},
      "eul_iter": {"type": "number", "minimum": 1, "description": "Newton iterations"},
      "delay": {"type": "number", "minimum": 0, "description": "Maximal delay"},
      "bvp_max_iterates": {"type": "number", "minimum": 1, "description": "BVP maximum iterates"},
      "bvp_tolerance": {"type": "number", "exclusiveMinimum": 0, "description": "BVP tolerance"},
      "bvp_epsilon": {"type": "number", "exclusiveMinimum": 0, "description": "BVP epsilon"},
      "vmaxpts": {"type": "integer", "minimum": 1, "maximum": 10000000},
      "poincare_map": {"type": "string", "enum": ["none", "section", "max", "period"]},
      "poincare_variable": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
      "poincare_sign": {"type": "integer"},
      "poincare_stop": {"type": "integer"},
      "poincare_plane": {"type": "number"}
    }},
    "run": {"type": "object", "additionalProperties": false, "properties": {
      "current_time": {"type": "number"},
      "last_time": {"type": "number"},
      "my_start": {"type": "integer"},
      "inflag": {"type": "integer"},
      "delay_flag": {"type": "integer"}
    }},
    "initial": {"type": "object", "additionalProperties": {"type": "number"}},
    "ending": {"type": "object", "additionalProperties": {"type": "number"}},
    "parameters": {"type": "object", "additionalProperties": {"type": "number"}},
    "delays": {"type": "object", "additionalProperties": {"type": "string"}},
    "boundary": {"type": "object", "additionalProperties": {"type": "string"}},
    "graphics": {"type": "object", "additionalProperties": false, "properties": {
      "curves": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "properties": {"x": {"type": "string"}, "y": {"type": "string"}, "z": {"type": "string"}, "line": {"type": "integer"}, "color": {"type": "integer"}}}},
      "rm": {"type": "array", "items": {"type": "number"}, "minItems": 9, "maxItems": 9},
      "z_plane": {"type": "number"},
      "z_view": {"type": "number"},
      "perspective": {"type": "integer"},
      "three_d": {"type": "integer"},
      "time": {"type": "integer"},
      "color_flag": {"type": "integer"},
      "type": {"type": "integer"},
      "color_scale": {"type": "number"},
      "min_scale": {"type": "number"},
      "xmax": {"type": "number"},
      "xmin": {"type": "number"},
      "ymax": {"type": "number"},
      "ymin": {"type": "number"},
      "zmax": {"type": "number"},
      "zmin": {"type": "number"},
      "xbar": {"type": "number"},
      "dx": {"type": "number"},
      "ybar": {"type": "number"},
      "dy": {"type": "number"},
      "zbar": {"type": "number"},
      "dz": {"type": "number"},
      "theta": {"type": "number"},
      "phi": {"type": "number"},
      "xshift": {"type": "integer"},
      "yshift": {"type": "integer"},
      "zshift": {"type": "integer"},
      "xlo": {"type": "number"},
      "ylo": {"type": "number"},
      "old_xlo": {"type": "number"},
      "old_ylo": {"type": "number"},
      "xhi": {"type": "number"},
      "yhi": {"type": "number"},
      "old_xhi": {"type": "number"},
      "old_yhi": {"type": "number"}
    }},
    "transpose": {"type": "object", "additionalProperties": false, "properties": {
      "first_column": {"type": "string"},
      "columns": {"type": "integer", "minimum": 1, "maximum": 4096},
      "rows": {"type": "integer", "minimum": 1, "maximum": 4096},
      "row_skip": {"type": "integer"},
      "col_skip": {"type": "integer"},
      "row0": {"type": "integer"}
    }},
    "coupling": {"type": "object", "additionalProperties": {"type": "string"}},
    "array_plot": {"type": "object", "additionalProperties": false, "properties": {
      "first_column": {"type": "string"},
      "columns": {"type": "integer", "minimum": 1, "maximum": 4096},
      "first_row": {"type": "integer"},
      "rows": {"type": "integer", "minimum": 1, "maximum": 4096},
      "row_skip": {"type": "integer"},
      "zmin": {"type": "number"},
      "zmax": {"type": "number"}
    }},
    "torus": {"type": "object", "additionalProperties": false, "properties": {
      "on": {"type": "integer", "enum": [0, 1]},
      "period": {"type": "number"},
      "fold": {"type": "array", "items": {"type": "string"}}
    }},
    "range": {"type": "object", "additionalProperties": false, "properties": {
      "rangeover": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
      "rangestep": {"type": "integer"},
      "rangelow": {"type": "number"},
      "rangehigh": {"type": "number"},
      "rangereset": {"type": "string", "enum": ["no", "yes"]},
      "rangeoldic": {"type": "string", "enum": ["no", "yes"]},
      "rangefiles": {"type": "string", "enum": ["no", "yes"]},
      "rangeover2": {"type": "string"},
      "rangelow2": {"type": "number"},
      "rangehigh2": {"type": "number"},
      "rangecycle": {"type": "integer"}
    }},
    "equilibrium_range": {"type": "object", "additionalProperties": false, "properties": {
      "item": {"type": "string"},
      "stab_col": {"type": "integer"},
      "shoot": {"type": "integer"},
      "steps": {"type": "integer"},
      "low": {"type": "number"},
      "high": {"type": "number"}
    }},
    "bvp_range": {"type": "object", "additionalProperties": false, "properties": {
      "item": {"type": "string"},
      "side": {"type": "integer"},
      "cycle": {"type": "integer"},
      "steps": {"type": "integer"},
      "low": {"type": "number"},
      "high": {"type": "number"}
    }}
  }
}
