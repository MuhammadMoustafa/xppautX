# 10x10.odex: converted from 10x10.ode by xppautX --convert (docs/odex.md)
version 4
# renamed: t is t_ here (.odex reserves t)

# setup a table for 10x10 nn coupled oscillators
# with natural boundary conditions
#  arrays are only 1-d so 0..9 10-19... are the rows
# t=0..99, get x,y
fun x(t_) = t_ mod 10
fun y(t_) = flr(t_/10)
# negative and positive with clamps
fun n(x) = max(x-1, 0)
fun p(x) = min(x+1, 9)
# pull back together
fun s(x, y) = 10*y+x
# here is the interaction function
fun h(x) = sin(x+phi)-sin(phi)
par phi = 0
# set tstart to negative to ignore global, else generate random ICs
par tstart = 0
# get the indices for north south east west
table nr s(x(t), p(y(t))), n=100, lo=0, hi=99
table so s(x(t), n(y(t))), n=100, lo=0, hi=99
table ea s(p(x(t)), y(t)), n=100, lo=0, hi=99
table we s(n(x(t)), y(t)), n=100, lo=0, hi=99
# now just add up the ODEs
x[j]' = 1+h(shift(x0, nr(j))-x[j])+h(shift(x0, so(j))-x[j])+h(shift(x0, we(j))-x[j])+h(shift(x0, ea(j))-x[j]) for j in 0..99
# make them all periodic
# set periodic colormap
options {
  animation: "10x10.anix",
  integration: {
    torus.fold: x0, torus.fold: x1, torus.fold: x2, torus.fold: x3, torus.fold: x4, torus.fold: x5, torus.fold: x6, torus.fold: x7, torus.fold: x8,
    torus.fold: x9, torus.fold: x10, torus.fold: x11, torus.fold: x12, torus.fold: x13, torus.fold: x14, torus.fold: x15, torus.fold: x16, torus.fold: x17,
    torus.fold: x18, torus.fold: x19, torus.fold: x20, torus.fold: x21, torus.fold: x22, torus.fold: x23, torus.fold: x24, torus.fold: x25,
    torus.fold: x26, torus.fold: x27, torus.fold: x28, torus.fold: x29, torus.fold: x30, torus.fold: x31, torus.fold: x32, torus.fold: x33,
    torus.fold: x34, torus.fold: x35, torus.fold: x36, torus.fold: x37, torus.fold: x38, torus.fold: x39, torus.fold: x40, torus.fold: x41,
    torus.fold: x42, torus.fold: x43, torus.fold: x44, torus.fold: x45, torus.fold: x46, torus.fold: x47, torus.fold: x48, torus.fold: x49,
    torus.fold: x50, torus.fold: x51, torus.fold: x52, torus.fold: x53, torus.fold: x54, torus.fold: x55, torus.fold: x56, torus.fold: x57,
    torus.fold: x58, torus.fold: x59, torus.fold: x60, torus.fold: x61, torus.fold: x62, torus.fold: x63, torus.fold: x64, torus.fold: x65,
    torus.fold: x66, torus.fold: x67, torus.fold: x68, torus.fold: x69, torus.fold: x70, torus.fold: x71, torus.fold: x72, torus.fold: x73,
    torus.fold: x74, torus.fold: x75, torus.fold: x76, torus.fold: x77, torus.fold: x78, torus.fold: x79, torus.fold: x80, torus.fold: x81,
    torus.fold: x82, torus.fold: x83, torus.fold: x84, torus.fold: x85, torus.fold: x86, torus.fold: x87, torus.fold: x88, torus.fold: x89,
    torus.fold: x90, torus.fold: x91, torus.fold: x92, torus.fold: x93, torus.fold: x94, torus.fold: x95, torus.fold: x96, torus.fold: x97,
    torus.fold: x98, torus.fold: x99, total_time: 50, method: euler,
  },
  plot: { curves: [ { x: x0, y: x21 } ], axes.x_low: 0, axes.x_high: 6.3, axes.y_low: 0, axes.y_high: 6.3, colormap: periodic },
}
# add the relative phase difference
aux y[j] = (x[j]-x0) mod (2*pi) for j in 0..99
# initial conditions
event 0 t-tstart, x[j] = ran(1)*2*pi for j in 0..99
