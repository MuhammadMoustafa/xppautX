# coupled Ginsberg-Landau equation
# cgl.ode
# parameters
@ dt=.25, total_time=300, transient_time=100

# what followed the .ode's done:
# Use the array to plot u0 256 cols 
# with colskip=2 rowskip=2,nrows=401,zlo=-1,zhi=+1
# 

fun ode_divisor(value) = if value then value else 2.23e-15
