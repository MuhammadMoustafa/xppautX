# exdaebvp.odex: converted from exdaebvp.ode by xppautX --convert (docs/odex.md)

u' = up
up' = v*up+lamu*(u-w)
0 = -k*w/ode_divisor(1+w)+lamv*(u-w)
solv w = 0.235
init u = 1, up = -0.34
aux ww = w
aux z = -k*w/ode_divisor(1+w)+lamv*(u-w)
par k = 1, lamu = 0.25, lamv = 0.25, v = 0.2, u0 = 1
boundary u-u0
boundary up'
# dae_ex3.ode
#  a boundary-value DAE model
# for the steady states of an artificial liver device
#
# vary v, the rate of flow
# slow flow u at the end is minimized, but dont clean much
#
# DAE stuff
# some extra stuff
@ total=5.001, jac_eps=1e-5, newt_tol=1e-5, dt=.005

fun ode_divisor(value) = if value then value else 2.23e-15
