# gb_wnet.odex: converted from gb_wnet.ode by xppautX --convert (docs/odex.md)

par c1x1 = 5000, c2x2 = 50, c3 = 5e-05, c4 = 5
init y1 = 1000, y2 = 2000
p1 = c1x1
p2 = c2x2*y1
p3 = c3*y1*y2*(y1-1)/2
p4 = c4*y1
network z = gill(0, P{1-4})
tr' = tr+z(0)
y1' = max(1, y1+z(1)-z(2)+z(3)-z(4))
y2' = max(1, y2+z(2)-z(3))
aux w[j] = z(j) for j in 0..4
# gb_wnet.ode
# gillespie algorithm for brusselator
# using the special declaration - it is a bit faster than by hand
# should work even better for more complex systems
# x1  -> y1 (c1)
# x2+y1 -> y2+Z (c2)
# 2 y1 + y2 -> 3 y1 (c3)
# y1 -> Z2 (c4)
#  compute the cumulative reactions
# time for next reaction
@ bound=100000000, method=Discrete, total_time=1000000, store_every=1000
@ xp=y1, yp=y2
@ xlo=0, ylo=0, xhi=10000, yhi=10000
