version: 4
model: "huygens.odex"
options { speed: 10, bounds: { x: [0, 1], y: [0, 1] } }
line { x1: 0.35, y1: 0.1, x2: 0.35, y2: 0.85, color: "foreground", width: 3 }
line { x1: 0.35, y1: 0.85, x2: 0.35+0.45*sin(p1), y2: 0.85-0.45*cos(p1), color: "#ff0000", width: 6 }
line { x1: 0.65, y1: 0.1, x2: 0.65, y2: 0.85, color: "foreground", width: 3 }
line { x1: 0.65, y1: 0.85, x2: 0.65+0.45*sin(p2), y2: 0.85-0.45*cos(p1), color: "#0000ff", width: 6 }
