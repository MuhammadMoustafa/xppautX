# mackey.odex: converted from mackey.ode by xppautX --convert (docs/odex.md)

x' = -g*x+b*f(delay(x, tau))
init x = 0.5
fun f(u) = u/ode_divisor(1+u^n)
aux xdel = delay(x, tau)
par tau = 6, g = 0.1, b = 0.2, n = 10
# mackey.ode
# mackey-glass equations
# delayed value of x
@ delay=30, total_time=600, store_every=10
@ xhi=600, yhi=2

fun ode_divisor(value) = if value then value else 2.23e-15
