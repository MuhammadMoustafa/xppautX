# qif-noise.odex: converted from qif-noise.ode by xppautX --convert (docs/odex.md)

# qif-noise.ode
# noisy qif that keeps track of spike times and ISI
# noise
wiener w
par sig = 0.1
par i = 0.1
par vhit = 20, vreset = -5
par maxcount = 1000.05
v' = v^2+i+sig*w
isi' = 0
count' = 0
tlast' = 0
# when v spikes, reset, compute isi, update tlast, output
event 1 v-vhit, v = vreset, isi = t-tlast, tlast = t, count = count+1, out_put = 1
# when 1000 are computed stop!
event 1 count-maxcount, arret = 1
# set plot
options {
  integration: { method: euler, state_limit: 100000000, total_time: 8000, store_from: 50000 },
  equilibria: { search_limit: 100000000 },
  plot: { xp: count, yp: isi, xlo: 0, xhi: 1000, ylo: 0, yhi: 100 },
}
