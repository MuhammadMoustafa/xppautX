# sine-circle.odex: converted from sine-circle.ode by xppautX --convert (docs/odex.md)
version 4
# @ total_time is set more than once in the .ode: XPP keeps the last value, 300

# example showing the del_shft orperator
table w exp(-abs(t)/ode_divisor(sig)), n=21, lo=-10, hi=10
par sig = 3
x[j]' = 1+k*sum(w(i')*sin(del_shft(x0, (i'+j) mod 100, tau*abs(i'))-x[j]), from=-10, to=10) for j in 0..99
par tau = 0.7
par k = 0.2
options {
  integration: {
    total_time: 300, delay.max_delay: 30, method: euler, store_from: 100, torus.fold: x0, torus.fold: x1, torus.fold: x2,
    torus.fold: x3, torus.fold: x4, torus.fold: x5, torus.fold: x6, torus.fold: x7, torus.fold: x8, torus.fold: x9, torus.fold: x10, torus.fold: x11,
    torus.fold: x12, torus.fold: x13, torus.fold: x14, torus.fold: x15, torus.fold: x16, torus.fold: x17, torus.fold: x18, torus.fold: x19,
    torus.fold: x20, torus.fold: x21, torus.fold: x22, torus.fold: x23, torus.fold: x24, torus.fold: x25, torus.fold: x26, torus.fold: x27,
    torus.fold: x28, torus.fold: x29, torus.fold: x30, torus.fold: x31, torus.fold: x32, torus.fold: x33, torus.fold: x34, torus.fold: x35,
    torus.fold: x36, torus.fold: x37, torus.fold: x38, torus.fold: x39, torus.fold: x40, torus.fold: x41, torus.fold: x42, torus.fold: x43,
    torus.fold: x44, torus.fold: x45, torus.fold: x46, torus.fold: x47, torus.fold: x48, torus.fold: x49, torus.fold: x50, torus.fold: x51,
    torus.fold: x52, torus.fold: x53, torus.fold: x54, torus.fold: x55, torus.fold: x56, torus.fold: x57, torus.fold: x58, torus.fold: x59,
    torus.fold: x60, torus.fold: x61, torus.fold: x62, torus.fold: x63, torus.fold: x64, torus.fold: x65, torus.fold: x66, torus.fold: x67,
    torus.fold: x68, torus.fold: x69, torus.fold: x70, torus.fold: x71, torus.fold: x72, torus.fold: x73, torus.fold: x74, torus.fold: x75,
    torus.fold: x76, torus.fold: x77, torus.fold: x78, torus.fold: x79, torus.fold: x80, torus.fold: x81, torus.fold: x82, torus.fold: x83,
    torus.fold: x84, torus.fold: x85, torus.fold: x86, torus.fold: x87, torus.fold: x88, torus.fold: x89, torus.fold: x90, torus.fold: x91,
    torus.fold: x92, torus.fold: x93, torus.fold: x94, torus.fold: x95, torus.fold: x96, torus.fold: x97, torus.fold: x98, torus.fold: x99,
  },
}
init x[j] = ran(1)*2*pi for j in 0..99

fun ode_divisor(value) = if value then value else 2.23e-15
