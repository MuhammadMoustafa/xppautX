# sine-circle.odex: converted from sine-circle.ode by xppautX --convert (docs/odex.md)

table w exp(-abs(t)/sig), n=21, lo=-10, hi=10
par sig = 3
x[j]' = 1+k*sum(w(i')*sin(del_shft(x0, (i'+j) mod 100, tau*abs(i'))-x[j]), from=-10, to=10) for j in 0..99
par tau = 0.7
par k = 0.2
init x[j] = ran(1)*2*pi for j in 0..99
# example showing the del_shft orperator
@ total=50
@ delay=30
@ meth=euler, total=300, trans=100
@ fold=x0
@ fold=x1
@ fold=x2
@ fold=x3
@ fold=x4
