# swindale.odex: converted from swindale.ode by xppautX --convert (docs/odex.md)

table wa exp(-a*t*t)-c*exp(-b*t*t), n=31, lo=-15, hi=15
par mu = 0.5, nu = 1.3
par a = 0.1, b = 0.025, c = 0.035
network k = conv(periodic, 101, 15, wa, n0)
n[j]' = n[j]*(1-n[j])*(mu*k(j)-nu) for j in 0..100
init n[j] = ran(1) for j in 0..100
# swindale.ode
# creates occular dominance stripes
# make a weight matrix - mexican hat
# convolve it
# random initial data
# ODEs
@ total_time=50
