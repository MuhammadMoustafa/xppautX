version: 4
# W520: the original grab tolerance was read as .02 by XPPAUT; see docs/odex-quirks.md.
model: "acoaster.odex"
options { speed: 10, bounds: { x: [-1.25, 1.25], y: [-1.25, 1.25] } }
permanent {
  value { x: -1, y: 1, label: "g=", value: g, size: 3, font: roman, color: "#a020f0" }
  line { x1: xM(0*0.04*pi), y1: zM(0*0.04*pi), x2: xM(1*0.04*pi), y2: zM(1*0.04*pi), color: "#00e100", width: 0 }
  line { x1: xM(1*0.04*pi), y1: zM(1*0.04*pi), x2: xM(2*0.04*pi), y2: zM(2*0.04*pi), color: "#00e100", width: 0 }
