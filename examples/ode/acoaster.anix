trail { x: X, y: Z, length: 5, draw: points, radius_pixels: 5, color: Lalt }
circle { x: X, y: Z, radius: 0.05, fill: "#ff0000", width: 0 }
grab { x: xM(M), y: zM(M), tolerance: 0.02, start: { M: (mouse_x+1.25)*2*pi/2.5, X: xM(M), Z: zM(M) }, end: { M: (mouse_x+1.25)*2*pi/2.5, X: xM(M), Z: zM(M), Lalt: sv*sign(mouse_vx)*sqrt(mouse_vx^2+mouse_vy^2) }, run: true }
