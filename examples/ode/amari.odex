# amari.odex: converted from amari.ode by xppautX --convert (docs/odex.md)

fun mh(x) = exp(-abs(x))-c*b*exp(-b*abs(x))
par c = 1.05, b = 0.5
table w mh(dx*t)*dx, n=101, lo=-50, hi=50
par dx = 0.1
fu[j] = heav(u[j]) for j in 0..199
network z = conv(even, 200, 50, w, fu0)
u[j]' = -u[j]-h+z(j) for j in 0..199
par h = 0.15
init u[j] = 0.8 for j in 90..110
# amari bump
@ total=100, meth=Euler
