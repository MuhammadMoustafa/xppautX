# atcoaster.odex: converted from atcoaster.ode by xppautX --convert (docs/odex.md)
# renamed: t is t_ here (.odex reserves t)
# names written as their declarations spell them (.odex names have case); the .ode's lines 9, 10

fun xM(t_) = (2+cos(3*t_))*sin(2*t_)
fun zM(t_) = (2+cos(3*t_))*cos(2*t_)
fun xMdM(t_) = (xM(t_+0.01)-xM(t_-0.01))/0.02
fun zMdM(t_) = (zM(t_+0.01)-zM(t_-0.01))/0.02
par alpha = 3, beta = 1, gamma = 1, delta = 0
par drag = 0.1
par mass = 1
par g = 1
par sv = 0.25
init M = 0, X = 0, Z = 3
init L = 0, Lalt = 1
fun normM(M) = sqrt(xMdM(M)^2+zMdM(M)^2)
fun mdt(M) = Lalt/ode_divisor(normM(M))
X' = xMdM(M)*mdt(M)
Z' = zMdM(M)*mdt(M)
M' = mdt(M)
L' = Lalt
Lalt' = 1/ode_divisor(mass)*(-g*zMdM(M)/ode_divisor(normM(M))-drag*Lalt)
set Sun = g = 274.13
set Mercury = g = 3.59
set Venus = g = 8.87
set Earth = g = 9.81
set Moon = g = 1.62
set Mars = g = 3.77
set Jupiter = g = 25.95
set Saturn = g = 11.08
set Uranus = g = 10.67
set Neptune = g = 14.07
set Pluto = g = 0.42
#Hey, define your roller coaster track here!
#Use parametric equations in M.
#Now calculate and put the derivatives of your
#parametric equations here:
# scale mouse velocity a little as it is too sensitive
#Shouldn't need to modify too much below...
#Thanks to Newton!
@ XP=X, YP=Z, XLO=-3.25, XHI=3.25, YLO=-3.25, YHI=3.25
@ bounds=100000
@ dt=.05, meth=cvode, tol=1e-10, atol=1e-10
@ total=50

fun ode_divisor(value) = if value then value else 2.23e-15
