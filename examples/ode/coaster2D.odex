# coaster2D.odex: converted from coaster2D.ode by xppautX --convert (docs/odex.md)

#Hey, define your roller coaster track here!
#Use parametric equations in M.
fun xM(M) = sin(M)
fun zM(M) = cos(M)
#Now calculate and put the derivatives of your
#parametric equations here:
fun xMdM(M) = cos(M)
fun zMdM(M) = -sin(M)
par drag = 1.2
par mass = 1
par g = 8.3
init M = 0, X = 0, Z = 1
init L = 0, Lalt = 0.01
#Shouldn't need to modify too much below...
fun normM(M) = sqrt(xMdM(M)^2+zMdM(M)^2)
fun mdt(M) = Lalt/ode_divisor(normM(M))
X' = xMdM(M)*mdt(M)
Z' = zMdM(M)*mdt(M)
M' = mdt(M)
L' = Lalt
#Thanks to Newton!
Lalt' = 1/ode_divisor(mass)*(-g*zMdM(M)/ode_divisor(normM(M))-drag*Lalt)
set "Sun" { g: 274.13 }
set "Mercury" { g: 3.59 }
set "Venus" { g: 8.87 }
set "Earth" { g: 9.81 }
set "Moon" { g: 1.62 }
set "Mars" { g: 3.77 }
set "Jupiter" { g: 25.95 }
set "Saturn" { g: 11.08 }
set "Uranus" { g: 10.67 }
set "Neptune" { g: 14.07 }
set "Pluto" { g: 0.42 }
options {
  integration: { state_limit: 100000 },
  equilibria: { search_limit: 100000 },
  plot: { xp: X, yp: Z, xlo: -1, xhi: 1, ylo: -1, yhi: 1 },
}

fun ode_divisor(value) = if value then value else 2.23e-15
