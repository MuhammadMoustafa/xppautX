# crazy.odex: converted from crazy.ode by xppautX --convert (docs/odex.md)
version 4

x' = -y+sin(1/ode_divisor(x))*x^2
y' = x
options {
  plot: { nullclines.mesh: 101, curves: [ { x: x, y: y } ], axes.x_min: -2, axes.x_max: 2, axes.y_min: -2, axes.y_max: 2 },
}

fun ode_divisor(value) = if value then value else 2.23e-15
