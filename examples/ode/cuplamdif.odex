# cuplamdif.odex: converted from cuplamdif.ode by xppautX --convert (docs/odex.md)

par lam = 1.5, q = 0.8, d = 1, u0 = 1, u10 = 0.95
spi = 1/sqrt(pi)
u(t) = u0*exp(-5*t)+spi*(volterra(exp(-t), of=f, mu=0.5)+volterra(exp(-t-d/ode_divisor(t+1e-04)), of=f1, mu=0.5))
v(t) = spi*(volterra(exp(-t), of=g, mu=0.5)+volterra(exp(-t-d/ode_divisor(t+1e-04)), of=g1, mu=0.5))
u1(t) = u10*exp(-5*t)+spi*(volterra(exp(-t), of=f1, mu=0.5)+volterra(exp(-t-d/ode_divisor(t+1e-04)), of=f, mu=0.5))
v1(t) = spi*(volterra(exp(-t), of=g1, mu=0.5)+volterra(exp(-t-d/ode_divisor(t+1e-04)), of=g, mu=0.5))
f = lam*u-v-(u*u+v*v)*(u+q*v)
g = lam*v+u-(u*u+v*v)*(v-q*u)
f1 = lam*u1-v1-(u1*u1+v1*v1)*(u1+q*v1)
g1 = lam*v1+u1-(u1*u1+v1*v1)*(v1-q*u1)
th1 = atan2(u, v)
th2 = atan2(u1, v1)
aux phi = (th1-th2) mod (2*pi)
aux ui = u10
aux dd = d
# cuplamdif.ode
# the functions F(u,v), G(u1,v1)
# the integral equations; since (0,0,0,0) is a rest point, I
# add a small quickly decaying transient
# the four functions f,g,f1,g1
@ autoeval=1
@ total=150

fun ode_divisor(value) = if value then value else 2.23e-15
