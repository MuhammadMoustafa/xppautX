# del_log.odex: converted from del_log.ode by xppautX --convert (docs/odex.md)
# Source: XPPAUT 8.0's demo ode/del_log.ode (W537 audit).

# illustrates a period 7 continuation for the delayed logistic map
y' = x
x' = r*x*(1-y)+eps
par r = 2.177, eps = 0
init x = 0.11, y = 0.21
options {
  integration: { method: discrete, total_time: 100, store_every: 7 },
  continuation: { max_step_size: .025, min_step_size: .00001, parameter_min: 2, parameter_max: 2.5 },
  diagram: { autoxmin: 2.17, autoxmax: 2.21, autoymin: 0, autoymax: 1 },
}
