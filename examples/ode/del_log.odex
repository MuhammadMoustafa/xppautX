# del_log.odex: converted from del_log.ode by xppautX --convert (docs/odex.md)

y' = x
x' = r*x*(1-y)+eps
par r = 2.177, eps = 0
init x = 0.11, y = 0.21
# illustrates a period 7 continuation for the delayed logistic map
@ method=Discrete, total_time=100, store_every=7
@ autoxmin=2.17, autoxmax=2.21, autoymin=0, autoymax=1
@ dsmax=.025, dsmin=.00001, parmin=2, parmax=2.5
