model: "duck.odex"
options { speed: 10, bounds: { x: [0, 1], y: [0, 1] } }
permanent {
  rectangle { x1: 0, y1: 0, x2: 0.4, y2: 0.4, color: "foreground", width: 0 }
  rectangle { x1: 0, y1: 0, x2: 0.4, y2: 0.3, fill: "#00c8c8", width: 0 }
}
line { x1: 0.5, y1: 0.5, x2: 0.5, y2: 0, color: "foreground", width: 4 }
line { x1: 0.5, y1: 0.5, x2: x1, y2: y1, color: "#ff0000", width: 4 }
line { x1: 0.5, y1: 0.5, x2: x2, y2: y2, color: "#ff0000", width: 4 }
circle { x: x1, y: y1, radius: 0.08, fill: mu/mutot, width: 0 }
circle { x: x2, y: y2, radius: 0.08, fill: 1-mu/mutot, width: 0 }
line { x1: x2, y1: y2, x2: x2-0.15*cos(x), y2: y2-0.15*sin(x), color: "#ffa500", width: 4 }
circle { x: x2, y: y2, radius: 0.02, fill: "foreground", width: 0 }
