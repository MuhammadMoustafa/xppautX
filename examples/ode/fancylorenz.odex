# fancylorenz.odex: converted from fancylorenz.ode by xppautX --convert (docs/odex.md)
version 4

# the lorenz equations
# with some fancy graphics options
x' = s*(-x+y)
y' = r*x-y-x*z
z' = -b*z+x*y
par r = 27, s = 10, b = 2.66
init x = -7.5, y = -3.6, z = 30
# now add some projection planes for 2D plote
aux x2 = xplane
aux y2 = yplane
aux z2 = zplane
par xplane = -35, yplane = 60, zplane = -10
# set up the numerics
# set up 3D plot
# tell XPP there are 4 plots altogether
# here are the 3 projections
# set up the 3D window
# and rotate the plot a bit so it looks nice
options {
  integration: { total_time: 50, dt: .02 },
  plot: {
    curves: [ { x: x, y: y, z: z }, { x: x, y: y, z: z2 }, { x: x, y: y2, z: z }, { x: x2, y: y, z: z } ], axes.kind: 3,
    axes.x_min: -40, axes.x_max: 18, axes.y_min: -24, axes.y_max: 64, axes.z_min: -12, axes.z_max: 45,
    axes.theta: 35,
  },
}
