# fhn.odex: converted from fhn.ode by xppautX --convert (docs/odex.md)
# renamed: t is t_ here (.odex reserves t)

v' = f(v)-w+s(t)+I_0
w' = eps*(v-gamma*w)
fun f(v) = v*(1-v)*(v-a)
fun s(t_) = al*sin(omega*t_)
par a = 0.25, eps = 0.05, gamma = 1, I_0 = 0.25
par al = 0, omega = 2
# Forced Fitzhugh-Nagumo fhn.ode
@ total=100, dt=.2, xhi=100
@ nplot=2, xp2=t, yp2=w
