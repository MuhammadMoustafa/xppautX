# fieldnoy.odex: converted from fieldnoy.ode by xppautX --convert (docs/odex.md)
version 4

# The Field-Noyes Equations.  A very hard problem for most numerical
# integrators.  A stiff method is absolutely necessary
init x = 1, y = 1, z = 1
par q = 8.375e-06, s = 77.27, f = 1, w = 0.161
x' = s*(y-x*y+x-q*x*x)
y' = (-y-x*y+f*z)/ode_divisor(s)
z' = w*(x-z)
aux lx = ln(abs(x))
aux ly = ln(abs(y))
aux lz = ln(abs(z))
options {
  integration: { method: cvode, total_time: 1000, dt: .5, step.relative_tolerance: 1e-8, step.absolute_tolerance: 1e-7, state_limit: 1e7 },
  equilibria: { search_limit: 1e7 },
  plot: { axes.x_low: 0, axes.x_high: 1000, axes.y_low: 0, axes.y_high: 12, curves: [ { y: lz } ] },
}

fun ode_divisor(value) = if value then value else 2.23e-15
