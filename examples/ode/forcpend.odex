# forcpend.odex: converted from forcpend.ode by xppautX --convert (docs/odex.md)
version 4

x' = y
y' = -sin(x)-f*y+a*cos(w*t)
par f = 0.1, w = 1, a = 1
options {
  integration: { total_time: 6.28, store_from: 6.275, dt: .0628 },
  plot: { axes.x_low: -10, axes.x_high: 10, axes.y_low: -2.5, axes.y_high: 2.5, curves.x: x, curves.y: y },
}
