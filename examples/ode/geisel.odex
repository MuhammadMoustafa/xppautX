# geisel.odex: converted from geisel.ode by xppautX --convert (docs/odex.md)

par a = 1.5, b = 0.5
x' = u
y' = v
u' = (a+b*cos(y))*sin(x)
v' = (a+b*cos(x))*sin(y)
init x = -30, y = -50, u = 1, v = 0.5
# an example due to Geisel with 1/f spectral properties
@ total_time=8000, dt=.25, storage_rows=100000, bound=100000, method=QualRK
