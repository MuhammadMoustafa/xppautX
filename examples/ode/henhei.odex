# henhei.odex: converted from henhei.ode by xppautX --convert (docs/odex.md)

x' = px
px' = -x-2*x*y
y' = py
py' = -y-x^2+y^2
aux e = 0.5*(px^2+py^2+x^2+y^2)+x^2*y-y^3/3
init x = 0.12, y = 0.12, px = 0.12, py = 0.12
# henon-heiles
# illustrates the use of the symplectic integrator
# try integration to 20000 with store_every=100 and plot the energy
# try again with Runge-Kutta
@ total=200, dt=.166666, meth=Symplectic
