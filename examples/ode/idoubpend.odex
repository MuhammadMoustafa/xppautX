# idoubpend.odex: converted from idoubpend.ode by xppautX --convert (docs/odex.md)

t1' = t1p
t2' = t2p
t2p' = -mu*t2p+1/(if L2*(m1+m2*sin(t2-t1)^2) then L2*(m1+m2*sin(t2-t1)^2) else 2.23e-15)*(-(m1+m2)*g*sin(t2)-(m1+m2)*L1*t1p^2*sin(t2-t1)+cos(t2-t1)*((m1+m2)*g*sin(t1)-m2*L2*t2p^2*sin(t2-t1)))
t1p' = -mu*t1p+1/(if L1*(m1+m2*sin(t2-t1)^2) then L1*(m1+m2*sin(t2-t1)^2) else 2.23e-15)*(-(m1+m2)*g*sin(t1)+m2*L2*t2p^2*sin(t2-t1)+cos(t2-t1)*(m2*g*sin(t2)+m2*L1*t1p^2*sin(t2-t1)))
par L1 = 4, L2 = 1, m1 = 2, m2 = 1, g = 9.8, mu = 0.01
init t1 = 1.5, t2 = 0
fun th1(x, y) = atan2(x-0.5, 0.5-y)
fun th1dot(x, y, xp, yp) = (xp*(0.5-y)+yp*(x-0.5))/(if (x-0.5)^2+(y-0.5)^2 then (x-0.5)^2+(y-0.5)^2 else 2.23e-15)
fun th2(x, y) = atan2(x-0.5-0.2*sin(t1), -y+0.5-0.2*cos(t1))
fun th2dot(x, y, xp, yp) = (xp*(0.5-0.2*cos(t1)-y)+yp*(x-0.5-0.2*sin(t1)))/(if (0.5-0.2*cos(t1)-y)^2+(x-0.5-0.2*sin(t1))^2 then (0.5-0.2*cos(t1)-y)^2+(x-0.5-0.2*sin(t1))^2 else 2.23e-15)
# parameters
@ total=200, bound=100000
