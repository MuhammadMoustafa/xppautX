# invpend.odex: converted from invpend.ode by xppautX --convert (docs/odex.md)
version 4

# the inverted pendulum driven periodically
# start at 0 and give it a push
par a = 0.3, omega = 10, k = 0.1
th' = v
v' = -k*v-(1+a*omega*omega*cos(omega*t))*sin(th)
init th = 0, v = 3
aux mth = th mod (2*pi)
options {
  animation: "invpend.anix",
  integration: { method: qualrk, total_time: 30 },
  plot: { curves: [ { x: t, y: mth } ], axes.x_min: 0, axes.x_max: 30, axes.y_min: 0, axes.y_max: 6.3, line.draw: points, line.marker: circle, line.marker_size: 2 },
}
