model: "itoy.odex"
options { speed: 50, bounds: { x: [-1.25, 3.25], y: [-1.25, 1.25] } }
line { x1: 0, y1: 0, x2: x1n[j], y2: y1n[j], color: "foreground", width: 3 } for j in 1..3
line { x1: 2.1, y1: 0, x2: x2n[j], y2: y2n[j], color: "foreground", width: 3 } for j in 1..3
circle { x: x1n[j], y: y1n[j], radius: 0.1, fill: "#ff0000", width: 0 } for j in 1..3
circle { x: x2n[j], y: y2n[j], radius: 0.1, fill: "#0000ff", width: 0 } for j in 1..3
grab { x: x1n1, y: y1n1, tolerance: 0.05, start: { t1: a+atan2(mouse_y, mouse_x) }, end: { t1: a+atan2(mouse_y, mouse_x), t1p: t1dot(mouse_x, mouse_y, mouse_vx, mouse_vy) }, run: true }
grab { x: x2n1, y: y2n1, tolerance: 0.05, start: { t2: a+atan2(mouse_y, mouse_x-2-d) }, end: { t2: a+atan2(mouse_y, mouse_x-2-d) }, run: false }
