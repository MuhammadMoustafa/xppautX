# izh_2003_tc_hyperpolarized.odex: converted from izh_2003_tc_hyperpolarized.ode by xppautX --convert (docs/odex.md)

# Izhikevich's simple model of a spiking neuron: thalamo-cortical (TC), hyperpolarized start.
# Izhikevich E.M. (2003) Simple model of spiking neurons. IEEE Trans. Neural Networks 14(6):1569-1572, Fig. 2, TC, right trace, starts at v=-87.
#   v' = 0.04 v^2 + 5 v + 140 - u + I,  u' = a (b v - u);
#   when v reaches 30 mV, v is set to c and u to u + d (the global event).
# Input: starts at -87 mV, held there by a current -Ih=-30 until t=T1=20, then released.
# n counts the spikes and ts is the time of the last one, both set where the reset is (bounds is raised: ts is a time,
# which the default bound of 100 would stop).
par a = 0.02, b = 0.25, c = -65, d = 0.05
par Ih = 30, T1 = 20
init v = -87, u = -21.75, n = 0, ts = 0
I = -Ih*(1-heav(t-T1))
v' = 0.04*v^2+5*v+140-u+I
u' = a*(b*v-u)
n' = 0
ts' = 0
event 1 v-30, v = c, u = u+d, n = n+1, ts = t
aux I = I
options {
  integration: { total_time: 150, dt: 0.025, store_every: 10, state_limit: 1000000 },
  equilibria: { search_limit: 1000000 },
}
