# izh_2004c_tonic_bursting.odex: converted from izh_2004c_tonic_bursting.ode by xppautX --convert (docs/odex.md)
version 4

# Izhikevich's simple model of a spiking neuron: tonic bursting.
# Izhikevich E.M. (2004) Which model to use for cortical spiking neurons? IEEE Trans. Neural Networks 15(5):1063-1070, Fig. 1, panel C.
#   v' = 0.04 v^2 + 5 v + 140 - u + I,  u' = a (b v - u);
#   when v reaches 30 mV, v is set to c and u to u + d (the global event).
# Input: step of current I0=15 at t=T1=22.
# n counts the spikes and ts is the time of the last one, both set where the reset is (bounds is raised: ts is a time,
# which the default bound of 100 would stop).
par a = 0.02, b = 0.2, c = -50, d = 2
par I0 = 15, T1 = 22
init v = -70, u = -14, n = 0, ts = 0
I = I0*heav(t-T1)
v' = 0.04*v^2+5*v+140-u+I
u' = a*(b*v-u)
n' = 0
ts' = 0
event 1 v-30, v = c, u = u+d, n = n+1, ts = t
aux I = I
options {
  integration: { total_time: 220, dt: 0.025, store_every: 10, state_limit: 1000000 },
  equilibria: { search_limit: 1000000 },
}
