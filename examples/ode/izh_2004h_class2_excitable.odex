# izh_2004h_class2_excitable.odex: converted from izh_2004h_class2_excitable.ode by xppautX --convert (docs/odex.md)
version 4

# Izhikevich's simple model of a spiking neuron: class 2 excitable.
# Izhikevich E.M. (2004) Which model to use for cortical spiking neurons? IEEE Trans. Neural Networks 15(5):1063-1070, Fig. 1, panel H.
#   v' = 0.04 v^2 + 5 v + 140 - u + I,  u' = a (b v - u);
#   when v reaches 30 mV, v is set to c and u to u + d (the global event).
# Input: current -0.5, then a ramp of slope r=0.015 from t=T1=30.
# n counts the spikes and ts is the time of the last one, both set where the reset is (bounds is raised: ts is a time,
# which the default bound of 100 would stop).
par a = 0.2, b = 0.26, c = -65, d = 0
par r = 0.015, T1 = 30
init v = -64, u = -16.64, n = 0, ts = 0
I = -0.5+r*(t-T1)*heav(t-T1)
v' = 0.04*v^2+5*v+140-u+I
u' = a*(b*v-u)
n' = 0
ts' = 0
event 1 v-30, v = c, u = u+d, n = n+1, ts = t
aux I = I
options {
  integration: { total_time: 300, dt: 0.025, store_every: 10, state_limit: 1000000 },
  equilibria: { search_limit: 1000000 },
}
