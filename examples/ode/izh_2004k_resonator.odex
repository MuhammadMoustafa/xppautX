# izh_2004k_resonator.odex: converted from izh_2004k_resonator.ode by xppautX --convert (docs/odex.md)
version 4

# Izhikevich's simple model of a spiking neuron: resonator.
# Izhikevich E.M. (2004) Which model to use for cortical spiking neurons? IEEE Trans. Neural Networks 15(5):1063-1070, Fig. 1, panel K.
#   v' = 0.04 v^2 + 5 v + 140 - u + I,  u' = a (b v - u);
#   when v reaches 30 mV, v is set to c and u to u + d (the global event).
# Input: four pulses I0=0.65 of width w=4: a pair 20 apart (T1, T2) and a pair 40 apart (T3, T4).
# n counts the spikes and ts is the time of the last one, both set where the reset is (bounds is raised: ts is a time,
# which the default bound of 100 would stop).
par a = 0.1, b = 0.26, c = -60, d = -1
par I0 = 0.65, w = 4, T1 = 40, T2 = 60, T3 = 280, T4 = 320
init v = -62, u = -16.12, n = 0, ts = 0
I = I0*(heav(t-T1)-heav(t-T1-w))+I0*(heav(t-T2)-heav(t-T2-w))+I0*(heav(t-T3)-heav(t-T3-w))+I0*(heav(t-T4)-heav(t-T4-w))
v' = 0.04*v^2+5*v+140-u+I
u' = a*(b*v-u)
n' = 0
ts' = 0
event 1 v-30, v = c, u = u+d, n = n+1, ts = t
aux I = I
options {
  integration: { total_time: 400, dt: 0.025, store_every: 10, state_limit: 1000000 },
  equilibria: { search_limit: 1000000 },
}
