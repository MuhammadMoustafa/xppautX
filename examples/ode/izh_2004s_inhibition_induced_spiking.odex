# izh_2004s_inhibition_induced_spiking.odex: converted from izh_2004s_inhibition_induced_spiking.ode by xppautX --convert (docs/odex.md)

# Izhikevich's simple model of a spiking neuron: inhibition-induced spiking.
# Izhikevich E.M. (2004) Which model to use for cortical spiking neurons? IEEE Trans. Neural Networks 15(5):1063-1070, Fig. 1, panel S.
#   v' = 0.04 v^2 + 5 v + 140 - u + I,  u' = a (b v - u);
#   when v reaches 30 mV, v is set to c and u to u + d (the global event).
# Input: a current Ih=80 lowered by Id=5 between t=T1=50 and t=T2=250.
# n counts the spikes and ts is the time of the last one, both set where the reset is (bounds is raised: ts is a time,
# which the default bound of 100 would stop).
par a = -0.02, b = -1, c = -60, d = 8
par Ih = 80, Id = 5, T1 = 50, T2 = 250
init v = -63.8, u = 63.8, n = 0, ts = 0
I = Ih-Id*(heav(t-T1)-heav(t-T2))
v' = 0.04*v^2+5*v+140-u+I
u' = a*(b*v-u)
n' = 0
ts' = 0
event 1 v-30, v = c, u = u+d, n = n+1, ts = t
aux I = I
options {
  integration: { total_time: 350, dt: 0.025, store_every: 10, state_limit: 1000000 },
  equilibria: { search_limit: 1000000 },
}
