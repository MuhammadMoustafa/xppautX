grab { x: xM(M), y: zM(M), tolerance: 0.25, start: { M: min(max(-5.6, mouse_x), 5.13), X: xM(M), Z: zM(M) }, end: { M: min(max(-5.6, mouse_x), 5.13), X: xM(M), Z: zM(M), Lalt: sv*sign(mouse_vx)*sqrt(mouse_vx^2+mouse_vy^2) }, run: true }
