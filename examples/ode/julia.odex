# julia.odex: converted from julia.ode by xppautX --convert (docs/odex.md)

par cx = 0, cy = 0
r = sqrt(sqrt((x-cx)^2+(y-cy)^2))
th = atan2(y-cy, x-cx)/2
s = sign(ran(1)-0.5)
x' = s*r*cos(th)
y' = s*r*sin(th)
# julia set for z -> z^2+c
@ total_time=2000, method=Discrete, transient_time=100, xlo=-2, ylo=-2, xhi=2, yhi=2, xp=x
@ yp=y
