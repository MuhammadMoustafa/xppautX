# julia.odex: converted from julia.ode by xppautX --convert (docs/odex.md)
version 4

# julia set for z -> z^2+c
par cx = 0, cy = 0
r = sqrt(sqrt((x-cx)^2+(y-cy)^2))
th = atan2(y-cy, x-cx)/2
s = sign(ran(1)-0.5)
x' = s*r*cos(th)
y' = s*r*sin(th)
options {
  integration: { total_time: 2000, method: discrete, store_from: 100 },
  plot: { xlo: -2, ylo: -2, xhi: 2, yhi: 2, xp: x, yp: y },
}
