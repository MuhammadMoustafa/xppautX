# koho.ode: the Kohonen algorithm. The winning unit, the weight closest to
# the stimulus, once came from a compiled C function (getmax.c, through
# export); compiled functions are gone (W55), and findext finds it here
par ntot=100,k=1
z=2*ran(1)-1
h(u)=(.5+.5*cos(2*pi*u*k/ntot))^sig
par sig=20,eps=.1
d[0..99]=abs(w[j]-z)
# mx(2) is the least distance, mx(3) its index
special mx=findext(-1,100,1,d0)
w[0..99]'=w[j]+eps*(z-w[j])*h(mx(3)-[j])
ip'=mx(3)
aux zz=z
@ meth=discrete,total=2000
done
