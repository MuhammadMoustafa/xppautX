# kuramot100m.odex: converted from kuramot100m.ode by xppautX --convert (docs/odex.md)

fun h(x, y) = sin(x-y+a)-sin(a)+b*sin(2*(x-y))
par a = 0.5, b = 0.2
par amp = 1, k = 1
table w amp*t/100, n=100, lo=0, hi=99
table mm 1/100, n=10000, lo=0, hi=9999
network mxh = fmmult(100, 100, mm, x0, x0, h)
x[j]' = w(j)+k*mxh(j) for j in 0..99
# kuramoto with fmmult
# linear gradient
@ total_time=100, bound=100000
