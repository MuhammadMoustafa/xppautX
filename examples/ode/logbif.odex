# logbif.odex: converted from logbif.ode by xppautX --convert (docs/odex.md)
version 4

# this is an example showing the logistic bifurcation diagram
fun f(x, a) = a*x*(1-x)
# here is the map
x' = f(x, aa)
# keep tabs on the parameter for plotting
a' = aa
# dummy index so you can change range without reloading
# ind=(nothing) in the .ode: XPP reads the number at its front, 0
par ind = 0
# define a in terms of the index ind over which we range
aa = amin+(amax-amin)*ind/200
#
init x = 0.1
# change amin and amax to change the window
par amin = 2, amax = 4
options {
  integration: { storage_rows: 11000, total_time: 400, store_from: 350, method: discrete },
  plot: { axes.x_low: 2, axes.x_high: 4.001, axes.y_low: 0, axes.y_high: 1.001, curves.x: a, curves.y: x, line.draw: points, line.marker: circle, line.marker_size: 0 },
  sweep: { write_files: true, variable: ind, reset: false, low: 0, high: 200, steps: 200 },
}
