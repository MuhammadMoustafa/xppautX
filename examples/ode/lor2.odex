# lor2.odex: converted from lor2.ode by xppautX --convert (docs/odex.md)
version 4

# the famous Lorenz equation set up for 3d view
init x = -7.5, y = -3.6, z = 30
init xp = -8, yp = 3, zp = 25
par c = 0
par r = 27, s = 10, b = 2.66666
x' = s*(-x+y)+c*(xp-x)
y' = r*x-y-x*z
z' = -b*z+x*y
xp' = s*(-xp+yp)+c*(x-xp)
yp' = r*xp-yp-xp*zp
zp' = -b*zp+xp*yp
options {
  integration: { dt: .025, total_time: 40 },
  plot: {
    curves: [ { x: x, y: y, z: z } ], axes.kind: 3, axes.x_min: -20, axes.x_max: 20, axes.y_min: -30, axes.y_max: 30, axes.z_min: 0, axes.z_max: 50,
    axes.x_low: -1.5, axes.y_low: -2, axes.x_high: 1.5, axes.y_high: 2, axes.phi: 60,
  },
}
