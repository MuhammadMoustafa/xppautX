# lorenz.odex: converted from lorenz.ode by xppautX --convert (docs/odex.md)
version 4

# the famous Lorenz equation set up for 3d view
init x = -7.5, y = -3.6, z = 30
par r = 27, s = 10, b = 2.66666
x' = s*(-x+y)
y' = r*x-y-x*z
z' = -b*z+x*y
options {
  integration: { dt: .025, total_time: 40 },
  plot: {
    curves: [ { x: x, y: y, z: z } ], axes.kind: 3, axes.x_min: -20, axes.x_max: 20, axes.y_min: -30, axes.y_max: 30, axes.z_min: 0, axes.z_max: 50,
    axes.phi: 60,
  },
}
