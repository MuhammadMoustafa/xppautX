# lorenz2.odex: converted from lorenz2.ode by xppautX --convert (docs/odex.md)
version 4

# the famous Lorenz equation set up for animated waterwheel and
# some delayed coordinates as well
init x = -7.5, y = -3.6, z = 30
par r = 27, s = 10, b = 2.66666
par c = 0.2, del = 0.1
x' = s*(-x+y)
y' = r*x-y-x*z
z' = -b*z+x*y
# x is proportional to the angular velocity so integral is angle
theta' = c*x
th[j] = theta+2*pi*j/8 for j in 0..7
# approximate the velocity vector in the butterfly coords
z1 = z-del*(-b*z+x*y)
x1 = x-del*(s*(-x+y))
options {
  animation: "lorenz.anix",
  integration: { dt: .025, total_time: 40, state_limit: 10000 },
  equilibria: { search_limit: 10000 },
  plot: {
    curves: [ { x: x, y: y, z: z } ], axes.kind: 3, axes.x_min: -20, axes.x_max: 20, axes.y_min: -30, axes.y_max: 30, axes.z_min: 0, axes.z_max: 50,
    axes.x_low: -1.5, axes.y_low: -2, axes.x_high: 1.5, axes.y_high: 2,
  },
}
