# lorknead.odex: converted from lorknead.ode by xppautX --convert (docs/odex.md)

init x = -7.5, y = -3.6, z = 30
par r = 27, s = 10, b = 2.66666
par q = 0.8
x' = s*(-x+y)
y' = r*x-y-x*z
z' = -b*z+x*y
event 1 x-y, p = p+(x>0)*q^count, count = count+(x>0), out_put = count>cmax, arret = count>cmax
event 1 y-x, p = p-(x<0)*q^count, count = count+(x<0), out_put = count>cmax, arret = count>cmax
count' = 0
p' = 0
aux xd = -x+y
par cmax = 25
aux rr = r
aux ss = s
# kneading sequences for the Lorenz equation
# 2 PAR RANGE r 20-120, s 10-70
# color by p
@ dt=.001, nout=10, total=40, trans=1000, bound=100000
