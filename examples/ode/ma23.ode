# ma23.ode: the fast-spiking parvalbumin interneuron (PVIN) of Ma et al. 2023, one
# compartment, five states: voltage SmV, Na inactivation SmNah, Kv1 and Kv3 gates
# SmKvn1 and SmK1n3, and the submembrane calcium SmSkcaI (uM) that drives the SK current.
#
# Source: the maintainer's parvocell_model/models/main.ode (an XPP export of the model).
# Citation: Ma et al. 2023, Table 1 and the model equations (the maintainer's transcription
# is docs/ma2023.md of that repository). The equations and every parameter of Table 1 agree
# with this file except E_Ca: Table 1 lists 68 mV, this file has 130 mV (ISmCa, as the export
# has it). The model is kept as exported; a comparison with the paper needs E_Ca = 68.
# SmStmplti is the applied current in pA (the export's constant step amplitude).
# tests/auto/ode_ma23.json continues SmStmplti. The run below (backward Euler, as the
# source, every 20th step stored) holds the model at 200 pA.

# Parameters
param SmStmplti = 200

# Initial conditions
init SmV = -49.996
init SmNah = 0.981431
init SmKvn1 = 0.022024
init SmK1n3 = 0.002077
init SmSkcaI = 0.07

# Algebraic equations
Smcpctncr = 30
Smdmtrxxf = 0
Smlength = 0
SmxlRsst8 = 100
SmLegMax = 8
SmNagMax = 300
SmNamVHlv = -17.5
SmNamVSlq = -11.4
SmNahlph3 = 0.0025
SmNahlphz = 23
SmNahlphp = 10
SmNahBtSb = 0.094
SmNahBtVu = -31
SmNahBtS6 = -5.5
SmKvgMax = 15
SmKvnlph9 = 0.002
SmKvnlph5 = -30
SmKvnlphv = -9
SmKvnBtSh = 0.017
SmKvnBtV0 = -35
SmKvnBtSc = 5.9
SmK1gMax = 180
SmK1nlph9 = 1.98
SmK1nlph5 = 96
SmK1nlphv = -12.6
SmK1nBtSh = 0.34
SmK1nBtV0 = -36
SmK1nBtSc = 10.5
SmCagMax = 8
SmCaVHlfj = 3
SmCaVSlpe = -10.4
SmSkgMax = 10
SmSkkSk = 0.8
SmSkhillN = 5
SmSkcRsts = 0.07
SmSkgamma = 0.01
SmSkbTot = 90
SmSkkD = 0.1
SmSkarea = 3000
SmSkshll8 = 0.1
SmStstrto = 100
SmStdrtnh = 500
SmStrpttk = 1
SmStntrvk = 0
ISmLe = SmLegMax * (SmV - (-50))
ISmNa = SmNagMax * (1 / (1 + exp((SmV - SmNamVHlv) / SmNamVSlq)))^3 * SmNah * (SmV - 58)
ahSmNa = SmNahlph3 * exp(-((SmV - SmNahlphz) / SmNahlphp))
bhSmNa = SmNahBtSb * (SmV - SmNahBtVu) / (1 - exp((SmV - SmNahBtVu) / SmNahBtS6))
rhSmNa = max(ahSmNa + bhSmNa, 1e-09)
hInfSmNa = ahSmNa / rhSmNa
thSmNa = 1 / rhSmNa
ISmKv = SmKvgMax * SmKvn1^4 * (SmV - (-80))
anSmKv = SmKvnlph9 * (SmV - SmKvnlph5) / (1 - exp((SmV - SmKvnlph5) / SmKvnlphv))
bnSmKv = SmKvnBtSh * exp(-(SmV - SmKvnBtV0) / SmKvnBtSc)
rnSmKv = max(anSmKv + bnSmKv, 1e-09)
nInfSmKv = anSmKv / rnSmKv
tnSmKv = 1 / rnSmKv
ISmK1 = SmK1gMax * SmK1n3^2 * (SmV - (-80))
anSmK1 = SmK1nlph9 * (SmV - SmK1nlph5) / (1 - exp((SmV - SmK1nlph5) / SmK1nlphv))
bnSmK1 = SmK1nBtSh * exp(-(SmV - SmK1nBtV0) / SmK1nBtSc)
rnSmK1 = max(anSmK1 + bnSmK1, 1e-09)
nInfSmK1 = anSmK1 / rnSmK1
tnSmK1 = 1 / rnSmK1
ISmCa = SmCagMax * (1 / (1 + exp((SmV - SmCaVHlfj) / SmCaVSlpe)))^2 * (SmV - 130)
ISmSk = SmSkgMax * (((SmSkcaI/SmSkkSk)^SmSkhillN) / (1 + (SmSkcaI/SmSkkSk)^SmSkhillN)) * (SmV - (-80))
tDurSmSt = (SmStrpttk-1)*(SmStdrtnh + SmStntrvk) + SmStdrtnh
ISmSt = SmStmplti

# Differential equations
SmNah' = (hInfSmNa - SmNah) / thSmNa
SmKvn1' = (nInfSmKv - SmKvn1) / tnSmKv
SmK1n3' = (nInfSmK1 - SmK1n3) / tnSmK1
SmSkcaI' = (1 / (1 + SmSkbTot/SmSkkD)) * ((-(ISmCa)) / (2 * 96485.33212000 * SmSkarea * SmSkshll8) - SmSkgamma * (SmSkcaI - SmSkcRsts))
SmV' = (-ISmLe -ISmNa -ISmKv -ISmK1 -ISmCa -ISmSk + ISmSt) / Smcpctncr

# XPP simulation options
@ xlo=0,xhi=1000.0,ylo=-90,yhi=50
@ dt=0.01, nout=20
@ but=fit:wf
@ but=int:ig
@ but=intl:il
@ but=auto:fa
@ meth=backeul
@ total=1000.0
@ YP=SmV
@ AUTOVAR=SmV
@ parmax=1, parmin=-10, AUTOXMIN=-0.1, AUTOXMAX=1.1, AUTOYMIN=-90, AUTOYMAX=20
@ NPR=100000, NMAX=1000
@ NTST=100
@ DSMAX=0.1

done
