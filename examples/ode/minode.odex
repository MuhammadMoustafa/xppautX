# minode.odex: converted from minode.ode by xppautX --convert (docs/odex.md)

table junk ran(1), n=50, lo=0, hi=49
x[j]' = -x[j]+junk(j) for j in 0..49
d[j] = abs(x[j]) for j in 0..49
network mx = findext(-1, 50, 1, d0)
aux lo = mx(2)
# minode.ode: lo, the least |x[j]|. It once came from a compiled C function
# (getmin.c, through export); compiled functions are gone (W55), and
# findext finds it here
# mx(2) is the least value, mx(3) its index
