#### Axon Hillock ####
ahLen=20*10^(-4)
ahDiam=12.94999838*10^(-4)
ahArea=Area(ahLen,ahDiam)
ahCArea=CArea(ahDiam)
ahGPas=1/225
ahEPas=-70
######################

########## Axon Hilloc Channels ########
########################################
# ---- ah_NafIsb1.inc ----
## ********************************************************** ##
# Author:       Muhammad Moustafa
# Email:        muhammadmoustafa@eng1.cu.edu.eg
# Affiliation:  Systems and Biomedical Engineering Department
#               Faculty of Engineering
#               Cairo University
## ********************************************************** ##

######## NafIsb1 ######
NaI_gb=1.3392
NaI_e=50.0
NaI_amA=18
NaI_bmA=38
NaI_th=40
NaI_tht=47
NaI_kap=7

NaI_g=NaI_gb*NaI_m^(3)*NaI_h

Ah_v2=vah-vtraub
Ah_v22=vah-vtraub2

NaI_a=0.4*vtrap(NaI_amA-Ah_v22,5)
NaI_b=0.4*vtrap(Ah_v22-NaI_bmA,5)

NaI_mt=1/(NaI_a+NaI_b)/tadj20
NaI_mf=NaI_a/(NaI_a+NaI_b)

NaI_ht=(NaI_th*tadj20)/(exp((Ah_v2+50)/15)+exp(-(Ah_v2+50)/16))
NaI_hf=1/(1+exp((Ah_v2+NaI_tht)/NaI_kap))

########################################

######################
##### Currents #######
IahNaI=NaI_g*(vah-NaI_e)
######################

#### state equations ####
dNaI_m/dt=(NaI_mf-NaI_m)/NaI_mt
dNaI_h/dt=(NaI_hf-NaI_h)/NaI_ht
######################

######################
#### init values #####
init NaI_m=0.0131252, NaI_h=0.864964
######################

#done
# ---- ah_NapIsb1.inc ----
## ********************************************************** ##
# Author:       Muhammad Moustafa
# Email:        muhammadmoustafa@eng1.cu.edu.eg
# Affiliation:  Systems and Biomedical Engineering Department
#               Faculty of Engineering
#               Cairo University
## ********************************************************** ##

######## NapIsb1 ######
NaP_gb=3.2971e-5
NaP_e=50.0
vtraub1=10
NaP_ampA=0.01
NaP_ampB=30.4
NaP_ampC=5
NaP_bmpA=0.00025
NaP_bmpB=34.7
NaP_bmpC=5

NaP_g=NaP_gb*NaP_mp^(3)

tadj1=2.2^((TEMP-20)/10)
NaP_v1=vah-vtraub1
NaP_a=vtrap1(NaP_v1,NaP_ampA,NaP_ampB,NaP_ampC)
NaP_b=vtrap2(NaP_v1,NaP_bmpA,NaP_bmpB,NaP_bmpC)
NaP_mpt=1/(NaP_a+NaP_b)/tadj1
NaP_mpf=NaP_a/(NaP_a+NaP_b)
#########################

######################
##### Currents #######
IahNaP=NaP_g*(vah-NaP_e)
######################

#### state equations ####
dNap_mp/dt=(Nap_mpf-Nap_mp)/Nap_mpt
######################

######################
#### init values #####
init NaP_mp=0.00214921
######################

#done
# ---- ah_KdrIsb1.inc ----
## ********************************************************** ##
# Author:       Muhammad Moustafa
# Email:        muhammadmoustafa@eng1.cu.edu.eg
# Affiliation:  Systems and Biomedical Engineering Department
#               Faculty of Engineering
#               Cairo University
## ********************************************************** ##

##### KdrIsb1 ###########
KI_gb=0.16552
KI_e=-80.0
KI_tht=20
KI_kap=-15
KI_tn=5

KI_g=KI_gb*KI_n^(4)

## subtract vtraub which is equal -10 not vtraub2
KI_v2=vah-vtraub

KI_nt=(KI_tn*tadj20)/(exp((KI_v2+40)/40)+exp(-(KI_v2+40)/50))
KI_nf=1/(1+exp((KI_v2+KI_tht)/KI_kap))
########################################

######################
##### Currents #######
IahKI=KI_g*(vah-KI_e)
######################

#### state equations ####
dKI_n/dt=(KI_nf-KI_n)/KI_nt
######################

#### init values #####
init KI_n=0.0649692
######################

#done
########################################

##### Currents #######
IahL=ahGPas*(vah-ahEPas)
IahIon=IahL+IahKI+IahNaP+IahNaI
IahComp=1/ahArea*(G_S_Ah*(vs-vah))
Iah=IahComp-IahIon
######################

######################
#### state equations ####
# dvah/dt=(Iah)/CM
######################

######################
#### init values #####
init vah=-70
######################

#done
