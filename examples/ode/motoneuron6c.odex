d2Len = 754.842*1.81*10^(-4)
d2Diam = 36.4297*10^(-4)
d2Area = Area(d2Len, d2Diam)
d2CArea = CArea(d2Diam)
d2GPas = 1/11000
d2EPas = -70
### Ion Channels ####
#####################################
# ---- dend2_CaDen.inc ----
## ********************************************************** ##
# Author:       Muhammad Moustafa
# Email:        muhammadmoustafa@eng1.cu.edu.eg
# Affiliation:  Systems and Biomedical Engineering Department
#               Faculty of Engineering
#               Cairo University
## ********************************************************** ##
###### CaD2en ######
# CaD2en ###
## L Type Channels ###
CaD2_gb = CaDen_Max
CaD2_e = 60
CaD2_thtm = -43
CaD2_kapm = -6
CaD2_Ot = 10
CaD2_Ot2 = 50
CaD2_Wt_d = 1200
CaD2_tilon = 1
CaD2_AranG = 0.5
CaD2_WG = 1
CaD2_Wth = 0.27
## Ca activate K Channels ###
CaD2_gkb = CaDen_Max*0.41
CaD2_nexp = 10
CaD2_kd = 5e-04
CaD2_St = 40
## Calcium Dynamics ###
CaD2_caio = 1e-04
CaD2_f = 0.01
CaD2_alpha = 1
CaD2_kca = 8
CaD2_ek = -80
##############
CaD2_Of = 1/ode_divisor(1+expmod((vd2-CaD2_thtm)/ode_divisor(CaD2_kapm)))
CaD2_Wf = 1/ode_divisor(1+expmod(-(vd2+57)/0.8))
CaD2_Wt = 50+1150/ode_divisor(CaD2_WG)/ode_divisor(1+expmod((vd2+32)/7))
CaD2_Sf = 1/ode_divisor((CaD2_kd/ode_divisor(CaD2_cai-1e-05))^CaD2_nexp+1)
CaD2_df = d_Flag(CaD2_Of-CaD2_O)
tRandG2 = 0
CaD2_tauC = CaD2_Wt_d*(1-0.76*tRandG2)-CaD2_Wt
CaD2_Wt2 = CaD2_tauC*CaD2_df
#######################
######################
##### Currents #######
CaD2_g = CaD2_gb*(CaD2_O*(CaD2_AranG*0.3+1))
CaD2_gkca = CaD2_S
CaD2_gk = CaD2_gkb*CaD2_gkca
Id2CaD2Ca = CaD2_g*(vd2-CaD2_e)
Id2CaD2K = CaD2_gk*(vd2-CaD2_ek)
Id2CaD2 = Id2CaD2Ca+Id2CaD2K
######################
######################
##### equations ######
CaD2_O' = (CaD2_Of-CaD2_O)*tauFunc(CaD2_tilon, CaD2_W, CaD2_df, CaD2_Wth)/ode_divisor(CaD2_Ot+CaD2_Ot2*CaD2_df)
CaD2_W' = (CaD2_Wf*(1-CaD2_df)-CaD2_W)/ode_divisor(CaD2_Wt+CaD2_Wt2)
CaD2_S' = (CaD2_Sf-CaD2_S)/ode_divisor(CaD2_St)
CaD2_cai' = CaD2_f*(-(CaD2_alpha*Id2CaD2Ca)-CaD2_kca*CaD2_cai)
######################
######################
#### init values #####
init CaD2_O = 0.0109869, CaD2_W = 8.76425e-08, CaD2_cai = 1e-04, CaD2_S = 0
######################
######################
######################
##### Currents #######
Id2L = d2GPas*(vd2-d2EPas)
Id2Ion = Id2L+Id2CaD2
Id2Comp = 1/ode_divisor(d2Area)*(G_d1_d2*(vd1-vd2)+G_d2_d3*(vd3-vd2))
Id2 = Id2Comp-Id2Ion
######################
### state equations ####
######################
######################
#### init values #####
init vd2 = -70
######################
