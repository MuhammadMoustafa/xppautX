# motoneuron6c.odex: converted from motoneuron6c.ode by xppautX --convert (docs/odex.md)
# names written as their declarations spell them (.odex names have case); the .ode's lines 115, 368, 384, 389
# @ total_time is set more than once in the .ode: XPP keeps the last value, 200
# @ xhi is set more than once in the .ode: XPP keeps the last value, 200
# @ total_time is set more than once in the .ode: XPP keeps the last value, 600

# motoneuron6c.ode: the 6-compartment spinal motoneuron of Moustafa et al. 2023,
# "Bifurcation analysis of spinal motoneuron firing behaviour" (soma, axon hillock and
# four dendrites; 25 states), current-clamped through ampPar (stimulus 50 * ampPar nA * 1e-6).
#
# Source: ModelDB 267710 at archive commit 2dd9ba299e56c3f2962f883afaada5a899c4e3f6,
# "XPPAUT Model/6cModel Xppaut": rest.ode (main.ode with @ total=600, the README's step 2,
# integration to the steady state) with its 19 include files inlined in the source's order,
# each marked by a "# ---- file ----" line.
# Staging edits (nothing else changed):
#   @ OUTPUT=output.dat   (opt.inc wrote ../simulations/xpp.dat, outside the model's folder)
#   @ total=600           (rest.ode's)
#   par CaDen_Max         (glob.inc's fixed CaDen_Max=0.000168, the dendritic L-type Ca / PIC
#                          density scaling both distal dendrites' Ca and Ca-activated K, is a
#                          parameter, the second one of the Hopf locus in tests/auto/)
## ********************************************************** ##
# Author:       Muhammad Moustafa
# Email:        muhammadmoustafa@eng1.cu.edu.eg
# Affiliation:  Systems and Biomedical Engineering Department
#               Faculty of Engineering
#               Cairo University
## ********************************************************** ##
vs' = (I/ode_divisor(sArea)+Is)/ode_divisor(CM)
vah' = Iah/ode_divisor(CM)
vd0' = Id0/ode_divisor(CM)
vd1' = Id1/ode_divisor(CM)
vd2' = Id2/ode_divisor(CM)
vd3' = Id3/ode_divisor(CM)
# ---- glob.inc ----
## ********************************************************** ##
# Author:       Muhammad Moustafa
# Email:        muhammadmoustafa@eng1.cu.edu.eg
# Affiliation:  Systems and Biomedical Engineering Department
#               Faculty of Engineering
#               Cairo University
## ********************************************************** ##
#### global constants ####
par ampPar = 0
TEMP = 36
CM = 0.001
Ra = 70
vtraub = -10
vtraub2 = -70
tadj = 3^((TEMP-36)/10)
tadj20 = 3^((TEMP-36)/10)
tadj23 = 3^((TEMP-36)/10)
FARADAY = 96484.56
R = 8.31441
par CaDen_Max = 0.000168
# ---- func.inc ----
## ********************************************************** ##
# Author:       Muhammad Moustafa
# Email:        muhammadmoustafa@eng1.cu.edu.eg
# Affiliation:  Systems and Biomedical Engineering Department
#               Faculty of Engineering
#               Cairo University
## ********************************************************** ##
### functions ###
fun Area(l, diam) = pi*l*diam
fun CArea(diam) = 0.25*pi*diam^2
fun dAtx(d0, df, x) = d0+x*(df-d0)
fun F_Area(r1, r2, h) = pi*(r1+r2)*((r1-r2)^2+h^2)^0.5
fun expmod(x) = if x<(-100) then 0 else exp(x)
fun vtrap(x, y) = if abs(x/ode_divisor(y))<1e-06 then y*(1-x/ode_divisor(y)/2) else x/ode_divisor(expmod(x/ode_divisor(y))-1)
fun vtrap1(x, a, b, c) = if abs((x+b)/ode_divisor(c))<1e-06 then a*c else a*(x+b)/ode_divisor(1-exp(-(x+b)/ode_divisor(c)))
fun vtrap2(x, a, b, c) = if abs((x+b)/ode_divisor(c))<1e-06 then -a*c else a*(-(x+b))/ode_divisor(1-exp((x+b)/ode_divisor(c)))
fun tauFunc(tail, w, df, wth) = 0.001+0.999/(1+exp((tail*w*df-wth)/0.006))
fun d_Flag(x) = 1/ode_divisor(1+expmod(5000*(x+0.01)))
# ---- soma.inc ----
## ********************************************************** ##
# Author:       Muhammad Moustafa
# Email:        muhammadmoustafa@eng1.cu.edu.eg
# Affiliation:  Systems and Biomedical Engineering Department
#               Faculty of Engineering
#               Cairo University
## ********************************************************** ##
####### soma ########
sLen = 48.8*10^(-4)
sDiam = 48.8*10^(-4)
sArea = Area(sLen, sDiam)
sCArea = CArea(sDiam)
sGPas = 1/225
sEPas = -70
######################
##### Ion Channels ###
# ---- soma_NafSmb1.inc ----
## ********************************************************** ##
# Author:       Muhammad Moustafa
# Email:        muhammadmoustafa@eng1.cu.edu.eg
# Affiliation:  Systems and Biomedical Engineering Department
#               Faculty of Engineering
#               Cairo University
## ********************************************************** ##
##### NafSmb1
NaS_gb = 0.06
NaS_amA = 22
NaS_bmA = 46
NaS_th = 40
NaS_tht = 47
NaS_kap = 7
NaS_e = 50
NaS_g = NaS_gb*Nas_m^3*Nas_h
v2 = vs-vtraub
v22 = vs-vtraub2
Nas_a = 0.4*vtrap(NaS_amA-v22, 5)
Nas_b = 0.4*vtrap(v22-NaS_bmA, 5)
Nas_mt = 1/ode_divisor(Nas_a+Nas_b)/ode_divisor(tadj)
Nas_mf = Nas_a/ode_divisor(Nas_a+Nas_b)
Nas_ht = NaS_th*tadj/ode_divisor(expmod((v2+50)/15)+expmod(-(v2+50)/16))
Nas_hf = 1/ode_divisor(1+expmod((v2+NaS_tht)/ode_divisor(NaS_kap)))
#######################
######################
##### Currents #######
IsNas = NaS_g*(vs-NaS_e)
######################
######################
##### equations ######
Nas_m' = (Nas_mf-Nas_m)/ode_divisor(Nas_mt)
Nas_h' = (Nas_hf-Nas_h)/ode_divisor(Nas_ht)
######################
######################
#### init values #####
init Nas_m = 0.00590903, Nas_h = 0.864964
######################
# ---- soma_KdrSmb1.inc ----
## ********************************************************** ##
# Author:       Muhammad Moustafa
# Email:        muhammadmoustafa@eng1.cu.edu.eg
# Affiliation:  Systems and Biomedical Engineering Department
#               Faculty of Engineering
#               Cairo University
## ********************************************************** ##
### KdrSmb1
Kdr_gb = 0.80048
Kdr_tn = 5
Kdr_tht = 20
Kdr_kap = -15
Kdr_e = -80
Kdr_g = Kdr_gb*Kdr_n^4
Kdr_nt = Kdr_tn*tadj/ode_divisor(expmod((v2+40)/40)+expmod(-(v2+40)/50))
Kdr_nf = 1/ode_divisor(1+expmod((v2+Kdr_tht)/ode_divisor(Kdr_kap)))
########################
######################
##### Currents #######
IsKdr = Kdr_g*(vs-Kdr_e)
######################
######################
##### equations ######
Kdr_n' = (Kdr_nf-Kdr_n)/ode_divisor(Kdr_nt)
######################
######################
#### init values #####
init Kdr_n = 0.0649692
######################
# ---- soma_CaSmb1.inc ----
## ********************************************************** ##
# Author:       Muhammad Moustafa
# Email:        muhammadmoustafa@eng1.cu.edu.eg
# Affiliation:  Systems and Biomedical Engineering Department
#               Faculty of Engineering
#               Cairo University
## ********************************************************** ##
## CaSmb1
#### N Type ###
Ca_gnb = 0.01
Ca_tmn = 15
Ca_thtmn = 14
Ca_thn = 50
Ca_ththn = 32
#### L Type ###
Ca_glb = 0
mlexp = 1
Ca_tml = 400
Ca_thtml = 45.8
kml = -3.7
### Ca activated K
Ca_gkb = 0.0221
Ca_nexp = 1
Ca_kd = 5e-04
cao = 2
f = 0.01
alpha = 1
kca = 8
Ca_ek = -80
Ca_v2 = vs-vtraub
Ca_e = 130
Ca_gn = Ca_gnb*Ca_mn^2*Ca_hn
Ca_gl = Ca_glb*Ca_ml^mlexp
Ca_gk = Ca_gkb*(CaI^Ca_nexp/ode_divisor(CaI^Ca_nexp+Ca_kd))
Ca_mnt = Ca_tmn*tadj
Ca_mnf = 1/(1+exp((Ca_v2+Ca_thtmn)/(-5)))
Ca_hnt = Ca_thn*tadj
Ca_hnf = 1/(1+exp((Ca_v2+Ca_ththn)/5))
Ca_mlt = Ca_tml*tadj
Ca_mlf = 1/(1+exp((Ca_v2+Ca_thtml)/ode_divisor(kml)))
######################
######################
##### Currents #######
IsCaN = Ca_gn*(vs-Ca_e)
IsCaL = Ca_gl*(vs-Ca_e)
IsCaK = Ca_gk*(vs-Ca_ek)
IsCa = IsCaN+IsCaL+IsCaK
######################
######################
##### equations ######
Ca_mn' = (Ca_mnf-Ca_mn)/ode_divisor(Ca_mnt)
Ca_hn' = (Ca_hnf-Ca_hn)/ode_divisor(Ca_hnt)
Ca_ml' = (Ca_mlf-Ca_ml)/ode_divisor(Ca_mlt)
CaI' = f*(-(alpha*(IsCaN+IsCaL))-kca*CaI)
######################
######################
#### init values #####
init Ca_mn = 0.000101029, Ca_hn = 0.996316, Ca_ml = 0.0210859, CaI = 1e-04
######################
######################
######################
##### Currents #######
IsL = sGPas*(vs-sEPas)
IsIon = IsL+IsNas+IsKdr+IsCa
IsComp = 1/ode_divisor(sArea)*(G_S_Ah*(vah-vs)+G_S_d0*(vd0-vs))
Is = IsComp-IsIon
######################
######################
##### equations ######
# dvs/dt=(I/sArea+Is)/CM    Written in the main File
######################
######################
#### init values #####
init vs = -70
######################
