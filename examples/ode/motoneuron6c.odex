#               Faculty of Engineering
#               Cairo University
## ********************************************************** ##
# increaseing parmax, NTST, can solve MX problem
# increasing NORMMAX, NMAX can solve EP
# ---- stim.inc ----
## ********************************************************** ##
# Author:       Muhammad Moustafa
# Email:        muhammadmoustafa@eng1.cu.edu.eg
# Affiliation:  Systems and Biomedical Engineering Department
#               Faculty of Engineering
#               Cairo University
## ********************************************************** ##
# bifurcation max value
# Note: setting maxAmp below 50 causes max out in bifurcation, 2000 is good, NTST=100
## stimulus current in nA, 10^-6 is the conversion factor to nA
maxAmp = 50
I = ampPar*maxAmp*10^(-6)
# W269 (#326): the README's step 2, integrate 600 ms to the steady state (stim.inc sets 200)
options {
  integration: { dt: 0.025, method: backward_euler, total_time: 600 },
  continuation: { parmax: 1, parmin: -10, npr: 100000, nmax: 10000000, ntst: 100, dsmax: 0.1 },
  diagram: { autoxmin: -0.1, autoxmax: 1.1, autoymin: -90, autoymax: 20 },
  plot: { xlo: 0, xhi: 200, ylo: -90, yhi: 50 },
  interface: { but: "fit:wf", but: "int:ig", but: "intl:il", but: "auto:fa" },
  output: { output: "output.dat" },
}

fun ode_divisor(value) = if value then value else 2.23e-15
