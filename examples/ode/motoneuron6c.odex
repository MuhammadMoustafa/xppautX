######################
##### state equations ####
CaD3_O' = (CaD3_Of-CaD3_O)*tauFunc(CaD3_tilon, CaD3_W, CaD3_df, CaD3_Wth)/ode_divisor(CaD3_Ot+CaD3_Ot2*CaD3_df)
CaD3_W' = (CaD3_Wf*(1-CaD3_df)-CaD3_W)/ode_divisor(CaD3_Wt+CaD3_Wt2)
CaD3_S' = (CaD3_Sf-CaD3_S)/ode_divisor(CaD3_St)
CaD3_cai' = CaD3_f*(-(CaD3_alpha*Id3CaD3Ca)-CaD3_kca*CaD3_cai)
######################
######################
#### init values #####
init CaD3_O = 0.0109869, CaD3_W = 8.76425e-08, CaD3_cai = 1e-04, CaD3_S = 0
######################
######################
######################
##### Currents #######
Id3L = d3GPas*(vd3-d3EPas)
Id3Ion = Id3L+Id3CaD3
Id3Comp = 1/ode_divisor(d3Area)*(G_d2_d3*(vd2-vd3))
Id3 = Id3Comp-Id3Ion
######################
######################
##### state equations ####
######################
######################
#### init values #####
init vd3 = -70
######################
