## ********************************************************** ##
#### Connect Compartments ###
R_S_Ah = Ra*(0.5*sLen/ode_divisor(sCArea)+0.5*ahLen/ode_divisor(ahCArea))
G_S_Ah = 1/ode_divisor(R_S_Ah)
R_S_d0 = Ra*(0.5*d0Len/ode_divisor(d0CArea))
G_S_d0 = 1/ode_divisor(R_S_d0)
R_d0_d1 = Ra*(0.5*d0Len/ode_divisor(d0CArea)+0.5*d1Len/ode_divisor(d1CArea))
G_d0_d1 = 1/ode_divisor(R_d0_d1)
R_d1_d2 = Ra*(0.5*d1Len/ode_divisor(d1CArea)+0.5*d2Len/ode_divisor(d2CArea))
G_d1_d2 = 1/ode_divisor(R_d1_d2)
R_d2_d3 = Ra*(0.5*d2Len/ode_divisor(d2CArea)+0.5*d3Len/ode_divisor(d3CArea))
G_d2_d3 = 1/ode_divisor(R_d2_d3)
# ---- opt.inc ----
## ********************************************************** ##
# Author:       Muhammad Moustafa
