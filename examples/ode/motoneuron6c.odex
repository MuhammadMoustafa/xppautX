NaI_m' = (NaI_mf-NaI_m)/ode_divisor(NaI_mt)
NaI_h' = (NaI_hf-NaI_h)/ode_divisor(NaI_ht)
######################
######################
#### init values #####
init NaI_m = 0.0131252, NaI_h = 0.864964
