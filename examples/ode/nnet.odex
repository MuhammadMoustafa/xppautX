# nnet.odex: converted from nnet.ode by xppautX --convert (docs/odex.md)

par w11 = 8, w12 = -6, w21 = 10, w22 = -1, tau = 3
par s1 = -2, s2 = -6
fun f(x) = 1/(1+exp(-x))
x' = -x+f(w11*x+w12*y+s1)
y' = (-y+f(w21*x+w22*y+s2))/ode_divisor(tau)
# The Wilson-Cowan neural net equations
# The phaseplane is fun to create

fun ode_divisor(value) = if value then value else 2.23e-15
