circle { x: V, y: X, radius: 0.25, fill: "#0000ff", width: 0 }
circle { x: 5, y: 2*gam, radius: 0.1, fill: "#ff0000", width: 0 }
circle { x: 4*beta, y: 0, radius: 0.1, fill: "#c8c800", width: 0 }
