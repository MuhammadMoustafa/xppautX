grab { x: V, y: X, tolerance: 0.4, start: { V: mouse_x, X: mouse_y }, end: { V: mouse_x, X: mouse_y }, run: true }
grab { x: 5, y: 2*gam, tolerance: 0.25, start: { gam: 0.5*abs(mouse_y) }, end: { gam: 0.5*abs(mouse_y) }, run: true }
grab { x: 4*beta, y: 0, tolerance: 0.25, start: { beta: 0.25*abs(mouse_x) }, end: { beta: 0.25*abs(mouse_x) }, run: true }
grab { x: -1, y: Input, tolerance: 0.25, start: { Input: mouse_y }, end: { Input: mouse_y }, run: true }
grab { x: 10*sigma, y: 9, tolerance: 0.25, start: { sigma: 0.1*abs(mouse_x) }, end: { sigma: 0.1*abs(mouse_x) }, run: true }
grab { x: 10*eps, y: 10, tolerance: 0.25, start: { eps: 0.1*abs(mouse_x) }, end: { eps: 0.1*abs(mouse_x) }, run: true }
