# osc.odex: converted from osc.ode by xppautX --convert (docs/odex.md)

par beta = 1.463, gam = 3.358, Input = 1.352, eps = 0.1, sigma = 0
init V = 2, X = 1.5
fun xm(z) = z
fun Vnull(z) = 3*z-z^3+2+Input
fun Xnull(z) = gam*(1+tanh(z/ode_divisor(beta)))
wiener z
V' = 3*V-V^3+2-X+Input+sigma*z
X' = eps*(gam*(1+tanh(V/ode_divisor(beta)))-X)
options {
  animation: "osc.anix",
  integration: { store_every: 10, storage_rows: 100000, total_time: 400, method: euler },
  continuation: { parameter_min: 0, parameter_max: 6, step_size: -0.001, max_step_size: .01 },
  diagram: { autovar: V },
  plot: { xp: V, yp: X, xlo: -3, xhi: 3, ylo: -3, yhi: 6 },
  interface: { but: "AUTO:fa" },
}

fun ode_divisor(value) = if value then value else 2.23e-15
