# pend-cart1-kick.odex: converted from pend-cart1-kick.ode by xppautX --convert (docs/odex.md)

par mc = 5, mp = 1
par l = 1, g = 9.8
par muc = 0.01, mup = 0.1
0 = (mc+mp)*xdd+mp*l*cos(th1)*th1dd-mp*l*sin(th1)*th1p^2+muc*xp
0 = cos(th1)*xdd+l*th1dd+g*sin(th1)+mup*th1p
solv xdd = 0
solv th1dd = 0
x' = xp
xp' = xdd
th1' = th1p
th1p' = th1dd
event 1 th1p, th1 = th1-kick, x = x+r*kick
par kick = 0.05, r = 0
aux xpp = xdd
aux th1pp = th1dd
init th1 = 1.5
# pendulum on a cart
# uses DAE solver to solve for x'', th1''
#
# pend-cart1.ode
#
# masses of cart and pendulum (kg)
# length (m) and gravity
# simple linear friction
# set up DAEs
#
#
# dynamics
#
# the physics isn't quite right, but now I will add a kick
# track accelerations
# nice ICs
@ dt=.02
