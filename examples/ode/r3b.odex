# r3b.odex: converted from r3b.ode by xppautX --convert (docs/odex.md)
version 4

# planar restricted 3 body problem
# the parameter set "period" is an approximate periodic solution
par m = 0.012277471
d1 = ((x+m)^2+y^2)^1.5
d2 = ((x-1+m)^2+y^2)^1.5
x' = u
y' = v
u' = 2*v+x-(1-m)*(x+m)/ode_divisor(d1)-m*(x-1+m)/ode_divisor(d2)
v' = -2*u+y-(1-m)*y/ode_divisor(d1)-m*y/ode_divisor(d2)
init x = 0.5, y = 0.87
set "period" {
            x: 0.994, y: 0, u: 0, v: -2.001583,
            options: {
              integration: { total_time: 17.2, dt: .05, method: dopri8 },
              plot: { xlo: -2, ylo: -2, xhi: 2, yhi: 2 },
            },
          }
options {
  integration: { total_time: 200 },
  plot: { xp: x, yp: y, xlo: 0, ylo: 0, xhi: 1.2, yhi: 1.2 },
}

fun ode_divisor(value) = if value then value else 2.23e-15
