# r3b.odex: converted from r3b.ode by xppautX --convert (docs/odex.md)

par m = 0.012277471
d1 = ((x+m)^2+y^2)^1.5
d2 = ((x-1+m)^2+y^2)^1.5
x' = u
y' = v
u' = 2*v+x-(1-m)*(x+m)/(if d1 then d1 else 2.23e-15)-m*(x-1+m)/(if d2 then d2 else 2.23e-15)
v' = -2*u+y-(1-m)*y/(if d1 then d1 else 2.23e-15)-m*y/(if d2 then d2 else 2.23e-15)
init x = 0.5, y = 0.87
set period = total = 17.2, dt = 0.05, x = 0.994, y = 0, u = 0, v = -2.001583, meth = 8, xlo = -2, ylo = -2, xhi = 2, yhi = 2
# planar restricted 3 body problem
# the parameter set "period" is an approximate periodic solution
@ total=200, xp=x, yp=y, xlo=0, ylo=0, xhi=1.2, yhi=1.2
