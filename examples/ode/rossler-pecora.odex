# rossler-pecora.odex: converted from rossler-pecora.ode by xppautX --convert (docs/odex.md)

init x = 1, y = 1, z = 0.2
par a = 0.2, b = 0.2, c = 7
par alpha = 0, c1 = 1, c2 = 0, c3 = 0
x' = -y-z
y' = x+a*y
z' = b+z*(x-c)
xl' = -yl-zl+alpha*c1*xl
yl' = xl+a*yl+alpha*c2*yl
zl' = zl*x+xl*z-c*zl+alpha*c3*zl
init xl = 1, yl = 0, zl = 0
par dtout = 1.1
init tt = 0
event 1 tt-dtout, tt = 0, norm = sqrt(xl^2+yl^2+zl^2), acc = acc+ln(norm), xl = xl/ode_divisor(norm), yl = yl/ode_divisor(norm), zl = zl/ode_divisor(norm)
tt' = 1
norm' = 0
acc' = 0
aux liap = acc/ode_divisor(max(1, t))
aux mya = alpha
# rossler attractor
@ bound=100000000
@ dt=.025001, total_time=1000, store_every=100, transient_time=999.99
@ runnow=1

fun ode_divisor(value) = if value then value else 2.23e-15
