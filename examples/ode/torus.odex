# torus.odex: converted from torus.ode by xppautX --convert (docs/odex.md)
version 4

# A differential equation on the Torus.  Use the "phAse spc" option to
#  integrate it.
# y=(nothing) in the .ode: XPP reads the number at its front, 0
init x = 1.5, y = 0
par w1 = 1, w2 = 1, beta = 1
x' = w1+beta*sin(y-x)
y' = w2+beta*sin(x-y)
options {
  integration: { torus.period: 6.28318531, torus.fold: x, torus.fold: y },
  plot: { curves: [ { x: x, y: y } ], axes.x_min: 0, axes.y_min: 0, axes.x_max: 6.3, axes.y_max: 6.3 },
}
