version: 4
model: "toy_ok.odex"
options { speed: 50, bounds: { x: [-1.25, 3.25], y: [-1.25, 1.25] } }
line { x1: 0, y1: 0, x2: 0.5*(x1n[j]+x1s[j]), y2: 0.5*(y1n[j]+y1s[j]), color: "foreground", width: 3 } for j in 1..3
line { x1: 2.1, y1: 0, x2: 0.5*(x2n[j]+x2s[j]), y2: 0.5*(y2n[j]+y2s[j]), color: "foreground", width: 3 } for j in 1..3
circle { x: 0.5*(x1n[j]+x1s[j]), y: 0.5*(y1n[j]+y1s[j]), radius: 0.1, fill: "foreground", width: 0 } for j in 1..3
circle { x: 0.5*(x2n[j]+x2s[j]), y: 0.5*(y2n[j]+y2s[j]), radius: 0.1, fill: "foreground", width: 0 } for j in 1..3
