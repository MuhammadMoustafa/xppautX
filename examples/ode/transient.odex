# transient.odex: converted from transient.ode by xppautX --convert (docs/odex.md)
version 4

# a problem with cool transients
x' = -x-5*y-z*y
y' = -y-85*x-x*z
z' = z/2+x*y+1
init x = 8, y = 2, z = 1
options {
  integration: { dt: .002, total_time: 20, state_limit: 1000, method: qualrk },
  equilibria: { search_limit: 1000 },
  plot: { curves: [ { x: x, y: z } ], axes.x_min: -125, axes.x_max: 125, axes.y_min: -125, axes.y_max: 10 },
}
