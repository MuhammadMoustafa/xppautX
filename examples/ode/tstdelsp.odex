# tstdelsp.odex: converted from tstdelsp.ode by xppautX --convert (docs/odex.md)
# @ total_time is set more than once in the .ode: XPP keeps the last value, 50

table w ran(1), n=250, lo=0, hi=249
table ind flr(ran(1)*50), n=250, lo=0, hi=249
table td 5*ran(1), n=250, lo=0, hi=249
network k1 = sparse(50, 5, w, ind, u0)
network k2 = delspar(50, 5, w, ind, td, u0)
fun f(u) = u/(1+u^2)
u[j]' = c0-u[j]-c1*f(k1(j))-c2*f(k2(j)) for j in 0..49
options {
  numerics: { total_time: 50, delay: 6 },
  auto: { autoeval: 0 },
}
par c0 = 0.5, c1 = 2, c2 = 0
