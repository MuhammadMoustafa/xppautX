# tstdll.ode: the van der Pol oscillator. It once came from a compiled C
# function (example.c's vdp, through export and dll_lib); compiled
# functions are gone (W55), and the plain right-hand sides do the same:
x'=y
y'=-x+a*y*(1-x*x)
par a=1
init x=1
# example.c's other two, the same way:
#   lv:   x'=a*x*(b-y), y'=c*y*(-d+x)
#   duff: x'=y, y'=x*(1-x*x)+a*sin(b*t)-c*y
done
