# Does not load: the second export line's input list is empty ("{}"),
# which the export syntax does not accept ("Cant export  - non existent!";
# XPPAUT 8 stops the same way). tstdll.ode is the working DLL example;
# tools/examples_check.sh expects "noload" here.
x'=xp
y'=yp
# these are dummies holding the RHS
xp=0
yp=0
export {x,y,a,b,c,d,t} {yp}
export {} {yp}
par a=1,b=1,c=1,d=1
init x=1
# @ dll_lib=example.so,dll_fun=vdp
done