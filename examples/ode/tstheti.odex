# tstheti.odex: converted from tstheti.ode by xppautX --convert (docs/odex.md)
version 4
# Source: XPPAUT 8.0's demo ode/tstheti.ode (W537 audit).

# tstheti.ode
# a heteroclinic orbit
# unstable at u=1, stable at u=0
fun f(u, up) = up
fun g(u, up) = -c*up-u*(1-u)*(u-a)
# the dynamics
u' = per*f(u, up)
up' = per*g(u, up)
# dummy equations for the fixed points
uleft' = 0
upleft' = 0
uright' = 0
upright' = 0
# the velocity parameter
c' = 0
# fixed points
boundary f(uleft, upleft)
boundary g(uleft, upleft)
boundary f(uright, upright)
boundary g(uright, upright)
# projection conditions
boundary hom_bcs(0)
boundary hom_bcs(1)
# parameters
par per = 6.67, a = 0.5
# initial data
init u = 0.918, up = -0.0577, c = 0
# initial fixed points
init uleft = 1, upleft = 0, uright = 0, upright = 0
# some AUTO parameters
options {
  integration: { total_time: 1.01, dt: .01 },
  continuation: {
    special_point_tolerance: 1e-7, state_tolerance: 1e-7, parameter_tolerance: 1e-7,
    parameter_max: 60, max_step_size: 5, min_step_size: 1e-4, mesh_intervals: 35,
  },
  plot: { xp: u, yp: up, xlo: -.25, xhi: 1.25, ylo: -.75, yhi: .25 },
}
