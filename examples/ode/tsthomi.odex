# tsthomi.odex: converted from tsthomi.ode by xppautX --convert (docs/odex.md)
version 4

# test of homoclinic stuff
fun f(x, y) = y
fun g(x, y) = x*(1-x)-a*y+sig*x*y
x' = f(x, y)*per
y' = g(x, y)*per
# auxiliary ODE for fixed point
xe' = 0
ye' = 0
# period
# free parameter
sig' = 0
# right-hand sides
boundary f(xe, ye)
boundary g(xe, ye)
# project off the fixed point from unstable manifold
boundary hom_bcs(0)
# project onto the stable manifold
boundary hom_bcs(1)
par per = 8.1, a = 0
init x = 0.1, y = 0.1
options {
  integration: { total_time: 1.01, method: dopri8, dt: .001 },
  plot: { xlo: -.2, xhi: 1.6, ylo: -1, yhi: 1, xp: x, yp: y },
}
