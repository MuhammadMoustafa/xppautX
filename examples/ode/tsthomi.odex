# tsthomi.odex: converted from tsthomi.ode by xppautX --convert (docs/odex.md)

fun f(x, y) = y
fun g(x, y) = x*(1-x)-a*y+sig*x*y
x' = f(x, y)*per
y' = g(x, y)*per
xe' = 0
ye' = 0
sig' = 0
boundary f(xe, ye)
boundary g(xe, ye)
boundary hom_bcs(0)
boundary hom_bcs(1)
par per = 8.1, a = 0
init x = 0.1, y = 0.1
# test of homoclinic stuff
# auxiliary ODE for fixed point
# period
# free parameter
# right-hand sides
# project off the fixed point from unstable manifold
# project onto the stable manifold
@ total=1.01, meth=8, dt=.001
@ xlo=-.2, xhi=1.6, ylo=-1, yhi=1, xp=x, yp=y
