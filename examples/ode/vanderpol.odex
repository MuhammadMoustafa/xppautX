# vanderpol.odex: converted from vanderpol.ode by xppautX --convert (docs/odex.md)
version 4

x' = xp
xp' = -x+xp*(1-x^2)
init x = 1
options {
  integration: { total_time: 40 },
  plot: { curves.count: 2, curves.x: t, curves.x2: t, curves.y: x, curves.y2: xp, axes.x_low: 0, axes.x_high: 40, axes.y_low: -3, axes.y_high: 3 },
}
init xp = 0
