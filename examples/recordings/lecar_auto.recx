{"step":"Sing pts → Go","keys":["s","g","n"]}
{"step":"Equilibrium → Import","win":"equilibrium","keys":["i"]}
{"step":"File","keys":["f"],"view":true}
{"step":"File → Auto","keys":["a"],"view":true}
{"step":"AUTO → Run → Steady state","win":"auto","keys":["r","s"]}
