@end

@file lecar.odex
# lecar.odex: converted from lecar.ode by xppautX --convert (docs/odex.md)
version 4

# The Morris-Lecar model as in our chapter in Koch & Segev
#  A simple membrane oscillator.
#
par iapp = 0.05, phi = 0.333
par v1 = -0.01, v2 = 0.15, v3 = 0.1, v4 = 0.145, gca = 1
par vk = -0.7, vl = -0.5, gk = 2, gl = 0.5, om = 1
fun minf(v) = 0.5*(1+tanh((v-v1)/ode_divisor(v2)))
fun ninf(v) = 0.5*(1+tanh((v-v3)/ode_divisor(v4)))
fun lamn(v) = phi*cosh((v-v3)/ode_divisor(2*v4))
ica = gca*minf(v)*(v-1)
v' = iapp+gl*(vl-v)+gk*w*(vk-v)-ica
w' = lamn(v)*(ninf(v)-w)
aux cur = iapp
aux ica = ica
aux ik = gk*w*(v-vk)
aux rate = phi
init v = -0.144, w = 0.03
# some options
# AUTO options
options {
  integration: { total_time: 30, dt: .05 },
  continuation: {
    min_step_size: 1e-5, max_step_size: .02, parameter_min: -.2, parameter_max: .5,
    output_every: 500, max_steps: 2000,
  },
  diagram: { y_max: .4, y_min: -.5, x_min: -.2, x_max: .5 },
  plot: { colormap: jet, axes.x_low: -.6, axes.x_high: 1.2, axes.y_low: -.25, axes.y_high: 1.2, curves: [ { x: v, y: w } ], direction_field.grid: 16, nullclines.draw: true, direction_field.draw: scaled_arrows },
}
#
# plot v vs time
set "vvst" {
          iapp: 0.1,
          options: {
            integration: { total_time: 100 },
            plot: { curves: [ { x: t, y: v } ], axes.x_low: 0, axes.x_high: 100, axes.y_low: -.6, axes.y_high: .5 },
          },
        }
# plot phaseplane
set "pp" { options: { plot: { curves: [ { x: v, y: w } ], axes.x_low: -.6, axes.x_high: 1.2, axes.y_low: -.25, axes.y_high: 1.2 } } }
# now some nice parameter sets for the homoclinic and the Hopf
set "snic" { v3: 0.1, v4: 0.145, gca: 1, phi: 0.333 }
set "hopf" { v3: 0, v4: 0.3, gca: 1.1, phi: 0.2 }
set "hom" { v3: 0.1, v4: 0.145, gca: 1, phi: 1.15 }
set "cool" { v3: 0.1, v4: 0.145, gca: 1, phi: 1.15, iapp: 0.080918 }
#
#  set up a little tutorial for channesl
"Channnels for the ML Eqns"
"The ML eqns have three channels Calcium, potassium and leak."
"To set parameters click on the asterisks"
"{total_time=100,iapp=.1} We first set the integration time to 100 and increase the current"
"Integrate the equations and see the nice limit cycle. Draw the nullclines."
"{gk=0} Now we block potassium. Integrate again and look at what happens"
"Draw the nullclines. Where is the V nullcline?"
"{gk=0,gca=0} Now we block both currents and integrate"
"{gk=2,gca=0} Now calcium is blocked. Explore this"
"{gk=2,gca=1.33} Back to normal.  Both currents are required for oscillations!"
"{gl=0} What happens with no leak???"

fun ode_divisor(value) = if value then value else 2.23e-15
@end

@steps
{"step":"File → Apply set","cmd":{"cmd":"set.apply","name":"hopf","scope":"all"}}
{"step":"Sing pts \u2192 Go","cmd":{"cmd":"equilibrium.find"}}
{"step":"Equilibrium \u2192 Import","cmd":{"cmd":"equilibrium.import_as_ic"}}
{"step":"File → autoX","cmd":{"cmd": "autox.open"},"view":true}
{"step":"autoX → Run → Equilibrium","cmd":{"cmd": "autox.run", "kind": "equilibrium", "replace_diagram": false, "follow_all_branches": false}}
{"step":"autoX → Grab","cmd":{"cmd": "autox.grab", "type": "hopf", "index": 1}}
{"step":"autoX → Run → Periodic","cmd":{"cmd": "autox.run", "kind": "periodic", "type": "hopf", "index": 1, "follow_all_branches": false}}
{"step":"autoX → File → Save diagram","cmd":{"cmd":"autox.save_session","file":"lecar.snapx"}}

