@file lorenz_homoclinic.odex
version 4
# Source: published: E. N. Lorenz, "Deterministic nonperiodic flow", J. Atmos. Sci. 20(2) (1963) 130-141, doi:10.1175/1520-0469(1963)020<0130:DNF>2.0.CO;2 (checked at Crossref, W537), with AUTO-07p's lrz demo (reference/auto-07p/demos/lrz) of sigma = 10, beta = 8/3; the homoclinic value below is Sparrow's and Kaplan-Yorke's.
# W403 (#465): the Lorenz equations at sigma = 10, b = 8/3, whose homoclinic orbit to the origin appears at r = 13.926
# (Sparrow, "The Lorenz Equations: Bifurcations, Chaos, and Strange Attractors", Springer 1982, Appendix C; also
# J. L. Kaplan and J. A. Yorke, "Preturbulence: a regime observed in a fluid flow model of Lorenz", Commun. Math. Phys.
# 67 (1979) 93-108: the pair of homoclinic loops at r = 13.926). The origin has one unstable eigenvalue (7.13) and two
# stable (-18.13, -8/3): HomCont runs it with NUNSTAB = 1, NSTAB = 2 in three dimensions.
# AUTO-07p's value at these constants, to the digits it prints, is compared with the published 13.926 in
# docs/auto-references.md. tests/autox/lorenz_homoclinic.json runs it.
x' = s*(y-x)
y' = r*x-y-x*z
z' = x*y-b*z
par r = 13.92655741, s = 10, b = 2.6666666666666665
init x = 0.0001, y = 0.000171297268, z = 0
@end

@steps
{"step":"autoX → Open autoX","cmd":{"cmd": "autox.open"},"view":true}
{"step":"autoX → Axes","cmd":{"cmd": "autox.configure_axes", "parameter1": "r"}}
{"step":"autoX → Run","cmd":{"cmd": "autox.run", "kind": "equilibrium", "replace_diagram": false, "follow_all_branches": false, "step_size": 0.5, "min_step_size": 1e-05, "max_step_size": 0.5, "max_steps": 300, "output_every": 100, "parameter_min": 0, "parameter_max": 31, "mesh_intervals": 35, "max_branch_switches": 0}}
{"step":"autoX → Run","cmd":{"cmd": "autox.run", "kind": "equilibrium", "label": 2, "switch": true, "follow_all_branches": false, "step_size": 0.5, "min_step_size": 1e-05, "max_step_size": 0.5, "max_steps": 300, "output_every": 100, "parameter_min": 0, "parameter_max": 31, "mesh_intervals": 35, "max_branch_switches": 0}}
{"step":"autoX → Run","cmd":{"cmd": "autox.run", "kind": "periodic", "label": 4, "follow_all_branches": false, "step_size": -0.5, "min_step_size": 1e-05, "max_step_size": 0.5, "max_steps": 300, "output_every": 2, "parameter_min": 0, "parameter_max": 40, "mesh_intervals": 35, "max_branch_switches": 0}}

