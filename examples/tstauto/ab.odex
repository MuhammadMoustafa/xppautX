# ab.odex: converted from ab.ode by xppautX --convert (docs/odex.md)
# Source: XPPAUT 8.0's demo tstauto/ab.ode (AUTO-07p has a demo of the same name, reference/auto-07p/demos/ab) (W537 audit).

e = exp(u2)
u1' = -u1+p0*(1-u1)*e
u2' = -u2+p0*p1*(1-u1)*e-p2*u2
par p0 = 0, p1 = 14, p2 = 2
init u1 = 0, u2 = 0
