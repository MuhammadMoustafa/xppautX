# bistable.odex: converted from bistable.ode by xppautX --convert (docs/odex.md)
version 4
# Source: XPPAUT 8.0's demo tstauto/bistable.ode (W537 audit).

# -c v' = f(v) + v''
#
options {
  integration: { total_time: 20 },
}
fun f(v) = v*(1-v)*(v-a)+p
par c = 0.56
par a = 0.1, p = 0
v' = vp
vp' = -c*vp-f(v)
init v = 0.995, vp = -0.0039366
