# pen.odex: converted from pen.ode by xppautX --convert (docs/odex.md)

par gamma = 0.175, eps = 0.1, ri = 0.4
ph1' = ps1
ph2' = ps2
ps1' = -eps*ps1-sin(ph1)+ri+gamma*(ph2-ph1)
ps2' = -eps*ps2-sin(ph2)+ri+gamma*(ph1-ph2)
init ph1 = 1.24, ph2 = 1.24, ps1 = 4.078, ps2 = 4.078
@ total=1.573879, dt=.01
