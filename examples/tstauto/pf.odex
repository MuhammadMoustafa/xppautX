# pf.odex: converted from pf.ode by xppautX --convert (docs/odex.md)

# load this in XPP
# click File AUTO, in Autom Run Steady ststr
x' = r*x-x^3
par r = -1
init x = 0
options {
  continuation: { dsmax: .1, parmin: -2, parmax: 2 },
  diagram: { autoxmin: -1.25, autoxmax: 2, autoymin: -2, autoymax: 2, autovar: x },
}
