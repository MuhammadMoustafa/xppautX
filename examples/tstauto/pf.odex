# pf.odex: converted from pf.ode by xppautX --convert (docs/odex.md)
version 4
# Source: XPPAUT 8.0's demo tstauto/pf.ode (W537 audit).

# load this in XPP
# click File AUTO, in Autom Run Steady ststr
x' = r*x-x^3
par r = -1
init x = 0
options {
  continuation: { max_step_size: .1, parameter_min: -2, parameter_max: 2 },
  diagram: { x_min: -1.25, x_max: 2, y_min: -2, y_max: 2, variable: x },
}
