# pp2.odex: converted from pp2.ode by xppautX --convert (docs/odex.md)
# Source: XPPAUT 8.0's demo tstauto/pp2.ode (AUTO-07p has a demo of the same name, reference/auto-07p/demos/pp2) (W537 audit).

e = exp(-par2*u0)
u0' = par1*u0*(1-u0)-u0*u1-par0*(1-e)
u1' = -u1+par3*u0*u1
par par0 = 0, par1 = 3, par2 = 5, par3 = 3
