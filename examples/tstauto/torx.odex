# torx.odex: converted from torx.ode by xppautX --convert (docs/odex.md)
# Source: XPPAUT 8.0's demo tstauto/torx.ode (W537 audit).

x' = (-(be+rn)*x+be*y-a3*(x*(x*x))+b3*((y-x)*((y-x)*(y-x))))/ode_divisor(r)
y' = be*x-(be+ga)*y-z-b3*((y-x)*((y-x)*(y-x)))
z' = y
par rn = -0.9, be = 0.5, ga = -0.6, r = 0.6, a3 = 0.328578, b3 = 0.933578
options {
  continuation: {
    min_step_size: 1e-4, max_step_size: .01, parameter_min: -.9, parameter_max: -.4,
    output_every: 500, max_steps: 125, parameter_tolerance: 1e-7, state_tolerance: 1e-7,
    special_point_tolerance: 1e-5, step_size: .001,
  },
  diagram: { autoymax: 1, autoymin: -1, autoxmin: -.9, autoxmax: -.4 },
}

fun ode_divisor(value) = if value then value else 2.23e-15
