# wcbiwave.odex: converted from wcbiwave.ode by xppautX --convert (docs/odex.md)
version 4
# Source: XPPAUT 8.0's demo tstauto/wcbiwave.ode (W537 audit).

u' = k*(-u+f(a*w-b))/ode_divisor(c)
w' = k*z
z' = k*(w-u)
par c = 1, k = 1, a = 15, b = 5
fun f(x) = 1/(1+exp(-x))
options {
  integration: { dt: .01 },
  plot: { curves.x: u, curves.y: z, axes.x_low: -.1, axes.y_low: -1, axes.y_high: 1, axes.x_high: 1.2 },
}

fun ode_divisor(value) = if value then value else 2.23e-15
