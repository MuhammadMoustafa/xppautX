# Izhikevich's simple model of a spiking neuron: resonator (RZ).
# Izhikevich E.M. (2003) Simple model of spiking neurons. IEEE Trans. Neural Networks 14(6):1569-1572, Fig. 2, RZ.
#   v' = 0.04 v^2 + 5 v + 140 - u + I,  u' = a (b v - u);
#   when v reaches 30 mV, v is set to c and u to u + d (the global event).
# Input: a small step Ib=0.2 at t=T0=20 and a brief pulse I0=2 of width w=2 at t=T1=100.
# n counts the spikes and ts is the time of the last one, both set where the reset is (bounds is raised: ts is a time,
# which the default bound of 100 would stop).
par a=0.1, b=0.26, c=-65, d=2
par Ib=0.2, T0=20, I0=2, T1=100, w=2
init v=-62.5, u=-16.25, n=0, ts=0
I = Ib*heav(t-T0)+I0*(heav(t-T1)-heav(t-T1-w))
v' = 0.04*v^2+5*v+140-u+I
u' = a*(b*v-u)
n' = 0
ts' = 0
global 1 v-30 {v=c; u=u+d; n=n+1; ts=t}
aux I = I
@ total=250, dt=0.025, nout=10, bounds=1000000
done
