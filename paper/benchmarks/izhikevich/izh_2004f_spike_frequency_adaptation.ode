# Izhikevich's simple model of a spiking neuron: spike frequency adaptation.
# Izhikevich E.M. (2004) Which model to use for cortical spiking neurons? IEEE Trans. Neural Networks 15(5):1063-1070, Fig. 1, panel F.
#   v' = 0.04 v^2 + 5 v + 140 - u + I,  u' = a (b v - u);
#   when v reaches 30 mV, v is set to c and u to u + d (the global event).
# Input: step of current I0=30 at t=T1=8.5.
# n counts the spikes and ts is the time of the last one, both set where the reset is (bounds is raised: ts is a time,
# which the default bound of 100 would stop).
par a=0.01, b=0.2, c=-65, d=8
par I0=30, T1=8.5
init v=-70, u=-14, n=0, ts=0
I = I0*heav(t-T1)
v' = 0.04*v^2+5*v+140-u+I
u' = a*(b*v-u)
n' = 0
ts' = 0
global 1 v-30 {v=c; u=u+d; n=n+1; ts=t}
aux I = I
@ total=85, dt=0.025, nout=10, bounds=1000000
done
