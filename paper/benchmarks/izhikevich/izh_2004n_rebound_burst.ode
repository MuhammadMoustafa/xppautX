# Izhikevich's simple model of a spiking neuron: rebound burst.
# Izhikevich E.M. (2004) Which model to use for cortical spiking neurons? IEEE Trans. Neural Networks 15(5):1063-1070, Fig. 1, panel N.
#   v' = 0.04 v^2 + 5 v + 140 - u + I,  u' = a (b v - u);
#   when v reaches 30 mV, v is set to c and u to u + d (the global event).
# Input: an inhibitory pulse I0=-15 of width w=5 at t=T1=20.
# n counts the spikes and ts is the time of the last one, both set where the reset is (bounds is raised: ts is a time,
# which the default bound of 100 would stop).
par a=0.03, b=0.25, c=-52, d=0
par I0=-15, T1=20, w=5
init v=-64, u=-16, n=0, ts=0
I = I0*(heav(t-T1)-heav(t-T1-w))
v' = 0.04*v^2+5*v+140-u+I
u' = a*(b*v-u)
n' = 0
ts' = 0
global 1 v-30 {v=c; u=u+d; n=n+1; ts=t}
aux I = I
@ total=200, dt=0.025, nout=10, bounds=1000000
done
