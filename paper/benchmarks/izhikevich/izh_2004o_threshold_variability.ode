# Izhikevich's simple model of a spiking neuron: threshold variability.
# Izhikevich E.M. (2004) Which model to use for cortical spiking neurons? IEEE Trans. Neural Networks 15(5):1063-1070, Fig. 1, panel O.
#   v' = 0.04 v^2 + 5 v + 140 - u + I,  u' = a (b v - u);
#   when v reaches 30 mV, v is set to c and u to u + d (the global event).
# Input: excitatory pulses I1=1 at 10-15 and 80-85, an inhibitory pulse I2=-6 at 70-75.
# n counts the spikes and ts is the time of the last one, both set where the reset is (bounds is raised: ts is a time,
# which the default bound of 100 would stop).
par a=0.03, b=0.25, c=-60, d=4
par I1=1, I2=-6
init v=-64, u=-16, n=0, ts=0
I = I1*(heav(t-10)-heav(t-15)+heav(t-80)-heav(t-85))+I2*(heav(t-70)-heav(t-75))
v' = 0.04*v^2+5*v+140-u+I
u' = a*(b*v-u)
n' = 0
ts' = 0
global 1 v-30 {v=c; u=u+d; n=n+1; ts=t}
aux I = I
@ total=100, dt=0.025, nout=10, bounds=1000000
done
