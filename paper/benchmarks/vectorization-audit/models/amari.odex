# amari.odex: converted from amari.ode by xppautX --convert (docs/odex.md)
version 4
# @ total_time is set more than once in the .ode: XPP keeps the last value, 100
# @ method is set more than once in the .ode: XPP keeps the last value, euler

# amari bump
fun mh(x) = exp(-abs(x))-c*b*exp(-b*abs(x))
par c = 1.05, b = 0.5
table w mh(dx*t)*dx, n=101, lo=-50, hi=50
par dx = 0.1
fu[j] = heav(u[j]) for j in 0..199
network z = conv(even, 200, 50, w, fu0)
u[j]' = -u[j]-h+z(j) for j in 0..199
par h = 0.15
init u[j] = 0.8 for j in 90..110
# Paper timing screen: explicit settings; source preserved in ../sources
options {
  integration: {
    total_time: 100, method: euler, dt: 0.05, start_time: 0, store_from: 0, store_every: 1,
    storage_rows: 20000, state_limit: 100000, stop_at_limit: true, relative_tolerance: .001, absolute_tolerance: .001, min_step: 1e-12,
    max_step: 1,
  },
}
