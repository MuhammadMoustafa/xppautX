# kuramot100.odex: converted from kuramot100.ode by xppautX --convert (docs/odex.md)
version 4
# @ total_time is set more than once in the .ode: XPP keeps the last value, 100
# @ bound is set more than once in the .ode: XPP keeps the last value, 100000

# kuramoto with sums
fun h(phi) = sin(phi+a)-sin(a)+b*sin(2*phi)
par a = 0.5, b = 0.2
# linear gradient
par amp = 1, k = 1
table w amp*t/100, n=100, lo=0, hi=99
x[j]' = w(j)+k*sum(h(shift(x0, i')-x[j]), from=0, to=99)/100 for j in 0..99
# Paper timing screen: explicit settings; source preserved in ../sources
options {
  integration: {
    total_time: 20, state_limit: 100000, stop_at_limit: true, dt: 0.05, method: runge_kutta, start_time: 0, store_from: 0,
    store_every: 1, storage_rows: 20000, relative_tolerance: .001, absolute_tolerance: .001, min_step: 1e-12,
    max_step: 1,
  },
}
init x0 = 0
init x1 = 0
init x2 = 0
