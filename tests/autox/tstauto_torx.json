{
  "model": "examples/tstauto/torx.odex",
  "reason": "Torus oscillator: use its supplied rn range and tolerances, then first HB.",
  "runs": [
    {
      "name": "steady",
      "kind": "equilibrium",
      "start": {
        "state": "current"
      },
      "parameter": "rn",
      "autox": {
        "step.initial": 0.01,
        "step.min": 1e-05,
        "step.max": 0.01,
        "limits.steps": 100,
        "output.every": 20,
        "limits.parameter_min": -0.9,
        "limits.parameter_max": -0.4,
        "mesh.intervals": 15,
        "max_branch_switches": 0,
        "newton.parameter_tolerance": 1e-07,
        "newton.state_tolerance": 1e-07,
        "newton.special_point_tolerance": 1e-05
      }
    },
    {
      "name": "cycles",
      "kind": "periodic",
      "start": {
        "run": "steady",
        "type": "hopf",
        "index": 1
      },
      "parameter": "rn",
      "autox": {
        "step.initial": 0.005,
        "step.min": 1e-05,
        "step.max": 0.005,
        "limits.steps": 30,
        "output.every": 10,
        "limits.parameter_min": -0.9,
        "limits.parameter_max": -0.4,
        "mesh.intervals": 15,
        "max_branch_switches": 0,
        "newton.parameter_tolerance": 1e-07,
        "newton.state_tolerance": 1e-07,
        "newton.special_point_tolerance": 1e-05
      }
    }
  ]
}
