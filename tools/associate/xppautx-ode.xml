<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-xpp-ode">
    <comment>XPP ODE model</comment>
    <comment xml:lang="en">XPP ODE model</comment>
    <icon name="xppautx"/>
    <glob pattern="*.ode"/>
  </mime-type>
  <mime-type type="text/x-xpp-odex">
    <comment>xppautX model (.odex)</comment>
    <comment xml:lang="en">xppautX model (.odex)</comment>
    <icon name="xppautx"/>
    <glob pattern="*.odex"/>
  </mime-type>
  <mime-type type="application/x-xppautx-session">
    <comment>xppautX session (.snapx)</comment>
    <comment xml:lang="en">xppautX session (.snapx)</comment>
    <sub-class-of type="application/zip"/>
    <icon name="xppautx"/>
    <glob pattern="*.snapx"/>
  </mime-type>
  <mime-type type="application/x-xppautx-auto">
    <comment>xppautX AUTO file (.autox)</comment>
    <comment xml:lang="en">xppautX AUTO file (.autox)</comment>
    <sub-class-of type="application/zip"/>
    <icon name="xppautx"/>
    <glob pattern="*.autox"/>
  </mime-type>
  <mime-type type="application/x-xppautx-recording">
    <comment>xppautX recording (.recx)</comment>
    <comment xml:lang="en">xppautX recording (.recx)</comment>
    <sub-class-of type="text/plain"/>
    <icon name="xppautx"/>
    <glob pattern="*.recx"/>
  </mime-type>
</mime-info>
