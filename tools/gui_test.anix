model: "lecar.odex"
options { speed: 5, bounds: { x: [-0.6, 0.4], y: [-0.1, 0.6] } }
permanent {
  text { x: -0.55, y: 0.55, text: "lecar  ", size: 3, font: roman, color: "#0000ff" }
  line { x1: -0.6, y1: 0, x2: 0.4, y2: 0, color: "foreground", width: 1 }
}
line { x1: v, y1: 0, x2: v, y2: w, color: "#ff0000", width: 3 }
line { x1: 0.05, y1: 0.05, relative: true, color: "foreground", width: 0 }
circle { x: v, y: w, radius: 0.03, color: "#a020f0", width: 0 }
circle { x: -0.4, y: w, radius: 0.02, fill: w, width: 0 }
rectangle { x1: -0.55, y1: 0.1, x2: -0.5, y2: 0.1+w, color: "foreground", width: 1 }
rectangle { x1: -0.45, y1: 0.1, x2: -0.4, y2: 0.1+w, fill: "#ffa500", width: 0 }
ellipse { x: 0, y: 0.4, radius_x: 0.1, radius_y: 0.05, color: "#0000ff", width: 1 }
ellipse { x: 0.2, y: 0.4, radius_x: 0.05, radius_y: w, fill: "#c8eb4b", width: 0 }
value { x: -0.55, y: 0.5, label: "t=", value: t, size: 1, font: symbol, color: "foreground" }
text { x: -0.3, y: 0.5, text: "done  ", size: 2, font: roman, color: "#ff0000" }
trail { x: v, y: w, length: 10, draw: points, radius_pixels: 2, color: "#ff0000" }
trail { x: v+0.2, y: w, length: 10, color: "#0000ff", width: 2 }
grab { x: v, y: w, tolerance: 0.05, start: { w: w }, end: {  }, run: false }
