# borrowed.odex: converted from borrowed.ode by xppautX --convert (docs/odex.md)

x' = x*(1-x^2-y^2)-y
y' = y*(1-x^2-y^2)+x
aux r = x^2+y^2
aux a = x+y
aux b = x-y
init x = 1, y = 0
# The derived data sets that borrow the stored columns (storage.h's
# LentColumns), shown again after a run grew the store or a load replaced
# the session (tools/autocheck.py's memory section, W117): a stable limit
# cycle of period 2*pi started on it, so the adjoint converges, with
# three auxiliaries so that the adjoint, its H function and a histogram
# each show stored columns beside their own; a small storage_rows, so that a
# longer run grows the store.
@ total_time=6.283185307179586, dt=0.010471975511965976, storage_rows=1000
@ postprocess=1, histbins=20, histcol=x, histlo=-1, histhi=1
