# cvode_stop.odex: converted from cvode_stop.ode by xppautX --convert (docs/odex.md)
version 4

# CVODE stopped by a step error after a successful CVode call: a delay
# longer than the maximal one (tools/autocheck.py's memory section, W117)
x' = -delay(x, tau)
par tau = 2
init x = 1
options {
  integration: { method: cvode, delay: 1, total_time: 5, dt: 0.05 },
}
