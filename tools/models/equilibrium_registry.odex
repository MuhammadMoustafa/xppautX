version 4
# W522: one real stable direction and a centre pair; two manifold files, no filename prompts.
x' = -x
y' = -z
z' = y
init x = 0, y = 0, z = 0
options {
  integration: { total_time: .1, dt: .05 },
  plot: { curves: [ { x: x, y: y } ], axes.x_min: -1, axes.x_max: 1, axes.y_min: -1, axes.y_max: 1 }
}
