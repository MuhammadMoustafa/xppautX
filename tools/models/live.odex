# live.odex: converted from live.ode by xppautX --convert (docs/odex.md)

par iapp = 0.05, phi = 0.333
par v1 = -0.01, v2 = 0.15, v3 = 0.1, v4 = 0.145, gca = 1
par vk = -0.7, vl = -0.5, gk = 2, gl = 0.5, om = 1
fun minf(v) = 0.5*(1+tanh((v-v1)/ode_divisor(v2)))
fun ninf(v) = 0.5*(1+tanh((v-v3)/ode_divisor(v4)))
fun lamn(v) = phi*cosh((v-v3)/ode_divisor(2*v4))
ica = gca*minf(v)*(v-1)
v' = iapp+gl*(vl-v)+gk*w*(vk-v)-ica
w' = lamn(v)*(ninf(v)-w)
init v = -0.144, w = 0.03
# The Morris-Lecar model (examples/ode/lecar.ode) integrated with a small
# step, so that 20 001 stored rows take about two seconds (a fast CI runner
# still gives the checks that edit during a run time to do it): the live plot
# checks (tools/servercheck.py, tools/web2check.mjs) watch it grow.
@ total=1000, dt=.001, store_every=50, maxstor=30000
@ xlo=-.6, xhi=1.2, ylo=-.25, yhi=1.2
@ xplot=v, yplot=w

fun ode_divisor(value) = if value then value else 2.23e-15
