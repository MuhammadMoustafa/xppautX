# lrz_w857.autox: W857 (#938), a published model whose script asks for follow_all_branches on its one run: AUTO-07p's lrz demo, the
# Lorenz equations at sigma = 10, beta = 8/3 (Lorenz 1963, tools/models/lorenz_homoclinic.odex), the same run as tests/autox/lrz_follow_all.json
# but from the model's own start (r = 13.9) instead of r = 0. The one run names follow_all_branches itself, so every variant of W857 must give
# the same diagram: the branch from the start both ways, the pitchfork's branches and the cycles from their Hopf points.
# Headless: xppautX lrz_w857.autox --silent
version: 4,
model: "lorenz_homoclinic.odex",
diagram: "lrz_w857_branches.csv",
runs: [
  { name: "all", kind: equilibrium, replace_diagram: true, parameters: ["r"],
    options: { step.initial: 0.5, step.min: 1e-5, step.max: 0.5, limits.steps: 300, output.every: 100, mesh.intervals: 35,
               limits.parameter_min: 0, limits.parameter_max: 31, follow_all_branches: true } },
]
