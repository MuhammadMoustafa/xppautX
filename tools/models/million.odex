# million.odex: converted from million.ode by xppautX --convert (docs/odex.md)
version 4

# A van der Pol oscillator stored 1 000 001 times (total/dt+1 rows), for
# the web2 checks that a plot of 10^6 points draws and zooms quickly
# (tools/web2check.mjs). Euler keeps the integration itself short.
par mu = 1
x' = y
y' = mu*(1-x^2)*y-x
init x = 2, y = 0
options {
  integration: { total_time: 10000, dt: .01, method: euler, state_limit: 100 },
  equilibria: { search_limit: 100 },
  plot: { axes.x_low: -2.5, axes.x_high: 2.5, axes.y_low: -3, axes.y_high: 3, curves: [ { x: x, y: y } ] },
}
