version 4
# W348: distinct axes and bounds in three model-defined plot windows.
x' = -x
y' = -2*y
init x = 1, y = 2
options {
  integration: { total_time: 1, dt: .1, method: runge_kutta },
  plot: { windows.multiple: 1, curves.count: 3, curves.x: x, curves.y: y,
          curves.x2: y, curves.y2: x, curves.x_low2: -2, curves.x_high2: 3, curves.y_low2: -4, curves.y_high2: 5,
          curves.x3: t, curves.y3: y, curves.x_low3: 0, curves.x_high3: 1, curves.y_low3: 0, curves.y_high3: 2 },
}
