# pictures.odex: the picture exports' golden model (tools/goldencheck.py, W492): the Morris-Lecar
# equations with colours that carry alpha, a dashed curve with diamond markers, nullclines in
# their own colours and the plasma colour scale
par iapp = 0.05, phi = 0.333
par v1 = -0.01, v2 = 0.15, v3 = 0.1, v4 = 0.145, gca = 1
par vk = -0.7, vl = -0.5, gk = 2, gl = 0.5
fun minf(v) = 0.5*(1+tanh((v-v1)/v2))
fun ninf(v) = 0.5*(1+tanh((v-v3)/v4))
fun lamn(v) = phi*cosh((v-v3)/(2*v4))
v' = iapp+gl*(vl-v)+gk*w*(vk-v)-gca*minf(v)*(v-1)
w' = lamn(v)*(ninf(v)-w)
init v = -0.144, w = 0.03
options {
  integration: { total_time: 30, dt: .05 },
  plot: {
    colormap: plasma, xlo: -.6, xhi: 1.2, ylo: -.25, yhi: 1.2, xp: v, yp: w,
    xnc: "#e8590c80", ync: "#2b9348",
    line.dash: dashed, line.width: 1.5, line.draw: both, line.marker: diamond, line.marker_size: 2,
    nullclines.draw: true,
  },
}
