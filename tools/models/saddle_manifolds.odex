version 4
# W533: a saddle at the origin, x unstable and y stable; both manifolds are exported, each from its own start.
x' = x
y' = -y
init x = 0, y = 0
options {
  integration: { total_time: 1, dt: .05 },
  plot: { curves: [ { x: x, y: y } ], axes.x_min: -1, axes.x_max: 1, axes.y_min: -1, axes.y_max: 1 }
}
