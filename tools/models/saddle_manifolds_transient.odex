version 4
# W533: the saddle of saddle_manifolds.odex with store_from 0.5: each branch still stores whole, from the saddle.
x' = x
y' = -y
init x = 0, y = 0
options {
  integration: { total_time: 1, dt: .05, store_from: .5 },
  plot: { curves: [ { x: x, y: y } ], axes.x_min: -1, axes.x_max: 1, axes.y_min: -1, axes.y_max: 1 }
}
