# shortnames.odex: converted from shortnames.ode by xppautX --convert (docs/odex.md)
version 4

# FitzHugh-Nagumo: longnames.ode with short names. The two must compute
# the same numbers (tools/autoxcheck.py, section names).
par i = 0
par eps = 0.08, a = 0.7
par b = 0.8
fun f(u) = u-u^3/3
dr = v+a
v' = f(v)-w+i
w' = eps*(dr-b*w)
aux tot = f(v)+i
init v = -1, w = -0.5
options {
  integration: { total_time: 100, dt: 0.05 },
  continuation: { parameter_min: 0, parameter_max: 2, max_step_size: 0.05 },
  diagram: { x_min: 0, x_max: 2, y_min: -2.5, y_max: 2.5 },
  plot: { curves: [ { x: v, y: w } ], axes.x_min: -2.5, axes.x_max: 2.5, axes.y_min: -1, axes.y_max: 2 },
}
