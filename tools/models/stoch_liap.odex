# stoch_liap.odex: converted from stoch_liap.ode by xppautX --convert (docs/odex.md)

# W31b: a linear system's maximal Liapunov exponent is exactly its rate
# constant a, since every perturbation grows/shrinks as e^(a t) regardless
# of size. tests/test_stochast_liap.cpp checks hrw_liapunov() against a
# with a small tolerance.
par a = -0.7
x' = a*x
init x = 1
options {
  integration: { total_time: 20, dt: .01, method: runge_kutta },
}
