version 4
# nullcline_delay.odex: a stop case of servercheck's stops section (docs/studies/w480-stops.md)

par tau=2
x' = -delay(x,tau)+y
y' = -x
init x = 1, y = 0
options {
  integration: { method: euler, total_time: 5, dt: 0.1, delay.max_delay: 1 },
  plot: { curves.x: x, curves.y: y, axes.x_low: -2, axes.x_high: 2, axes.y_low: -2, axes.y_high: 2 },
}
