version 4
# W433 (#495): two independent states, a Poincare section on x that stops the
# run; the subsystems are two under subsystem_split equations, one under run
x' = -x
y' = -y
init x = 1, y = 1
options {
  integration: { total_time: 5, dt: 0.1, subsystem_split: run },
  poincare: { map: section, variable: x, plane: 0.5, stop: true },
}
