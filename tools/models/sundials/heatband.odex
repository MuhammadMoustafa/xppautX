# W34: heat.odex with CVODE's banded linear solver (one diagonal each side)
par d = 50
l1 = 4*d*sin(pi/202)^2
l20 = 4*d*sin(20*pi/202)^2
u[1]' = d*(u[2]-2*u[1])
u[j]' = d*(u[j-1]-2*u[j]+u[j+1]) for j in 2..99
u[100]' = d*(u[99]-2*u[100])
init u[j] = sin(pi*j/101)+0.5*sin(20*pi*j/101) for j in 1..100
aux err = sqrt(sum(((shift(u1, i')-exact(i'+1))/(1+abs(exact(i'+1))))^2, from=0, to=99)/100)
fun exact(j) = exp(-l1*t)*sin(pi*j/101)+0.5*exp(-l20*t)*sin(20*pi*j/101)
@ total=2, dt=0.02, bandup=1, bandlo=1
